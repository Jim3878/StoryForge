@code {
    [Parameter, EditorRequired] public AudioCategory Category { get; set; }

    private AudioLibraryState State = null!;
    private DotNetObjectReference<AudioBrowserPanel>? _selfRef;
    private string _rootId = string.Empty;
    private string _headerRowId = string.Empty;
    private string _noteEditorId = string.Empty;

    private string _searchText = string.Empty;

    // Set whenever the scanned file list changes, so the next OnAfterRenderAsync pushes it (URLs + cached
    // waveforms) to audio-browser.js — only then, not on every render.
    private bool _entriesDirty = true;

    private string? _editingNoteFile;
    private string? _escapedNoteFile;
    private bool _focusNoteEditor;

    private AudioEntry? _contextMenuEntry;
    private double _contextMenuX;
    private double _contextMenuY;

    private List<AudioEntry>? _pendingConvert;
    private string? _convertError;

    private sealed class GainDialog
    {
        public AudioEntry Entry { get; init; } = null!;
        // The user confirmed the (externally changed) current file is the new original.
        public bool Adopt { get; init; }
        public string Url { get; init; } = string.Empty;
        public AudioLoudness? Loudness { get; set; }
        public bool Measuring { get; set; }
        public string? MeasureError { get; set; }
        public bool Normalize { get; set; }
        public double ManualDb { get; set; }
        public bool ListenOriginal { get; set; }
        public bool Playing { get; set; }
        public bool Loading { get; set; }
        public string? PreviewError { get; set; }
        public string? ApplyError { get; set; }
    }

    private GainDialog? _gain;

    // Non-null while a single-file write (套用/還原) runs — drives the blocking 轉檔中 overlay.
    private string? _writingMessage;

    // Name (no extension — a .wav becomes .ogg on write) of the row/card to pulse after a write.
    private string? _flashName;
    private int _flashToken;
    private string? _gainMessage;
    private AudioEntry? _adoptPromptEntry;
    private AudioEntry? _restoreEntry;
    private AudioEntry? _forgetEntry;
    private bool _pendingNormalize;
    private bool _showOrphans;
    private readonly Dictionary<string, string> _orphanTargets = new(StringComparer.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        var segment = Category == AudioCategory.Bgm ? "bgm" : "sfx";
        _rootId = $"ab-root-{segment}";
        _headerRowId = $"ab-header-{segment}";
        _noteEditorId = $"ab-note-edit-{segment}";

        State = new AudioLibraryState(Category, AppSettings, WaveformCache);
        State.Load();
        State.OnConvertProgress += OnConvertProgress;
        ReloadCoordinator.Subscribe(OnReload);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _selfRef ??= DotNetObjectReference.Create(this);
        if (firstRender)
            await JS.InvokeVoidAsync("storyForgeAudio.init", _rootId, _selfRef, PlaybackOptions);

        if (_entriesDirty)
        {
            _entriesDirty = false;
            await JS.InvokeVoidAsync("storyForgeAudio.setEntries", _rootId, State.Entries.Select(entry => new
            {
                name = entry.FileName,
                url = State.GetUrl(entry),
                peaks = State.GetWaveform(entry)?.Peaks,
            }).ToList());
        }
        else
        {
            await JS.InvokeVoidAsync("storyForgeAudio.redraw", _rootId, false);
        }

        if (State.Page.ViewMode == AudioPageSettings.ViewList && State.Entries.Count > 0)
            await JS.InvokeVoidAsync("storyForgeAudio.initColumns", _headerRowId, _selfRef);

        if (_focusNoteEditor)
        {
            _focusNoteEditor = false;
            await JS.InvokeVoidAsync("storyForgeAudio.focusNote", _noteEditorId);
        }
    }

    private object PlaybackOptions => new { autoPlay = State.Page.AutoPlay, loop = State.Page.Loop, volume = State.Page.Volume };

    private IEnumerable<AudioEntry> VisibleEntries
    {
        get
        {
            var search = _searchText.Trim();
            var entries = State.Entries.Where(e => search.Length == 0
                || e.FileName.Contains(search, StringComparison.OrdinalIgnoreCase)
                || State.GetNote(e).Contains(search, StringComparison.OrdinalIgnoreCase));
            return ApplySort(entries);
        }
    }

    // Values that don't exist yet (a duration still being decoded, an empty note) always sort after the
    // ones that do, in either direction — they're "no data", not "smallest".
    private IEnumerable<AudioEntry> ApplySort(IEnumerable<AudioEntry> entries)
    {
        var desc = State.Page.SortDescending;

        IEnumerable<AudioEntry> By<TKey>(Func<AudioEntry, TKey> key, IComparer<TKey>? comparer = null) =>
            desc ? entries.OrderByDescending(key, comparer) : entries.OrderBy(key, comparer);

        IEnumerable<AudioEntry> ByMissingLast<TKey>(Func<AudioEntry, bool> has, Func<AudioEntry, TKey> key, IComparer<TKey>? comparer = null)
        {
            var ordered = entries.OrderBy(e => has(e) ? 0 : 1);
            return desc ? ordered.ThenByDescending(key, comparer) : ordered.ThenBy(key, comparer);
        }

        return State.Page.SortColumn switch
        {
            "name" => By(e => e.FileName, NaturalStringComparer.Instance),
            "duration" => ByMissingLast(e => State.GetWaveform(e) != null, e => State.GetWaveform(e)?.DurationSeconds ?? 0),
            "format" => By(e => e.Format, StringComparer.Ordinal),
            "size" => By(e => e.SizeBytes),
            "gain" => ByMissingLast(e => State.GetAdjustment(e).Record != null, e => State.GetAdjustment(e).Record?.TotalGainDb ?? 0),
            "note" => ByMissingLast(e => State.GetNote(e).Length > 0, e => State.GetNote(e), StringComparer.Ordinal),
            _ => entries,
        };
    }

    private double TableWidth => State.Page.Columns.Sum(c => c.Width);

    private static string GetColumnLabel(string key) => key switch
    {
        "wave" => "音紋",
        "name" => "檔名",
        "duration" => "長度",
        "format" => "格式",
        "size" => "大小",
        "gain" => "音量",
        "note" => "備註",
        _ => key,
    };

    private RenderFragment RenderWave(AudioEntry entry, string extraClass) => @<div class="ab-wave @extraClass" data-name="@entry.FileName" title="@(State.Page.AutoPlay ? "游標停留自動從頭播放；點擊從該位置播放；移開停止" : "點擊從該位置播放；移開停止")">
        <canvas class="ab-wave-canvas" data-name="@entry.FileName"></canvas>
        <div class="ab-wave-progress"></div>
    </div>;

    private RenderFragment RenderCell(AudioEntry entry, string key) => key switch
    {
        "wave" => RenderWave(entry, string.Empty),
        "name" => @<span title="@entry.FileName">@entry.Name</span>,
        "duration" => @<span>@FormatDuration(entry)</span>,
        "format" => @<span>@entry.Format</span>,
        "size" => @<span>@FormatSize(entry.SizeBytes)</span>,
        "gain" => RenderGain(entry),
        "note" => RenderNoteCell(entry),
        _ => @<span></span>,
    };

    private RenderFragment RenderNoteCell(AudioEntry entry)
    {
        if (_editingNoteFile == entry.FileName)
        {
            return @<textarea id="@_noteEditorId" class="ab-note-edit" rows="1" value="@State.GetNote(entry)"
                              @onchange="e => SaveNote(entry, e.Value?.ToString())"
                              @onblur="() => _editingNoteFile = null"
                              @onkeydown="e => OnNoteKeyDown(entry, e)"></textarea>;
        }

        var note = State.GetNote(entry);
        return @<div class="ab-note-text" title="@note" @onclick="() => StartEditNote(entry)">
            @if (note.Length == 0)
            {
                <span class="ab-note-placeholder">（點擊輸入備註）</span>
            }
            else
            {
                @note
            }
        </div>;
    }

    private string FormatDuration(AudioEntry entry)
    {
        var waveform = State.GetWaveform(entry);
        if (waveform == null)
            return "…";
        // Short clips (most SFX) keep a tenth of a second — "0:01" for everything under two seconds would
        // make them indistinguishable.
        var seconds = waveform.DurationSeconds;
        if (seconds < 10)
            return $"0:{seconds:00.0}";
        var total = (int)Math.Round(seconds);
        return $"{total / 60}:{total % 60:00}";
    }

    private static string FormatSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024.0 / 1024.0:0.0} MB" : $"{Math.Max(1, (int)Math.Round(bytes / 1024.0))} KB";

    // ---- toolbar ----

    private async Task SetViewMode(string mode)
    {
        if (State.Page.ViewMode == mode)
            return;
        // The playing wave element is about to be destroyed by the re-render.
        await JS.InvokeVoidAsync("storyForgeAudio.stopAll");
        State.Page.ViewMode = mode;
        _editingNoteFile = null;
        State.SavePage();
    }

    private async Task OnAutoPlayChanged(ChangeEventArgs e)
    {
        State.Page.AutoPlay = e.Value is true;
        State.SavePage();
        await PushPlaybackOptions();
    }

    private async Task OnLoopChanged(ChangeEventArgs e)
    {
        State.Page.Loop = e.Value is true;
        State.SavePage();
        await PushPlaybackOptions();
    }

    // Slider drags update live (volume applies to a clip already playing) but only save on release.
    private async Task OnVolumeInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var value))
        {
            State.Page.Volume = Math.Clamp(value / 100.0, 0, 1);
            await PushPlaybackOptions();
        }
    }

    private void OnCardSizeInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var value))
            State.Page.CardSize = value;
    }

    private void OnSliderCommitted() => State.SavePage();

    private Task PushPlaybackOptions() => JS.InvokeVoidAsync("storyForgeAudio.updateOptions", _rootId, PlaybackOptions).AsTask();

    private async Task Rescan()
    {
        await JS.InvokeVoidAsync("storyForgeAudio.stopAll");
        State.Load();
        _entriesDirty = true;
    }

    private async Task OnReload()
    {
        State.Load();
        _entriesDirty = true;
        await InvokeAsync(StateHasChanged);
    }

    // ---- list columns ----

    private void OnColumnHeaderClicked(string key)
    {
        if (key == "wave")
            return;

        if (State.Page.SortColumn == key)
            State.Page.SortDescending = !State.Page.SortDescending;
        else
        {
            State.Page.SortColumn = key;
            State.Page.SortDescending = false;
        }
        State.SavePage();
    }

    [JSInvokable]
    public void OnColumnReordered(int oldIndex, int newIndex)
    {
        var columns = State.Page.Columns;
        if (oldIndex < 0 || oldIndex >= columns.Count || newIndex < 0 || newIndex >= columns.Count)
            return;

        var column = columns[oldIndex];
        columns.RemoveAt(oldIndex);
        columns.Insert(newIndex, column);
        State.SavePage();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnColumnResized(string key, double width)
    {
        var column = State.Page.Columns.FirstOrDefault(c => c.Key == key);
        if (column == null)
            return;

        column.Width = Math.Max(AudioPageSettings.MinColumnWidth, width);
        State.SavePage();
        StateHasChanged();
    }

    // ---- waveform ----

    [JSInvokable]
    public void OnWaveformComputed(string fileName, double durationSeconds, byte[] peaks)
    {
        State.StoreWaveform(fileName, durationSeconds, peaks);
        StateHasChanged();
    }

    // ---- notes ----

    private void StartEditNote(AudioEntry entry)
    {
        _editingNoteFile = entry.FileName;
        _escapedNoteFile = null;
        _focusNoteEditor = true;
    }

    private void OnNoteKeyDown(AudioEntry entry, KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _escapedNoteFile = entry.FileName;
            _editingNoteFile = null;
        }
    }

    private void SaveNote(AudioEntry entry, string? text)
    {
        // Esc means discard — a change event that still arrives for the editor Esc just closed is ignored.
        if (_escapedNoteFile == entry.FileName)
            return;
        State.SetNote(entry, text ?? string.Empty);
    }

    // ---- context menu ----

    private void OpenContextMenu(MouseEventArgs e, AudioEntry entry)
    {
        _contextMenuEntry = entry;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
    }

    private void CloseContextMenu() => _contextMenuEntry = null;

    private async Task CopyName(AudioEntry entry)
    {
        _contextMenuEntry = null;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", entry.Name);
    }

    private async Task RefreshWaveform(AudioEntry entry)
    {
        _contextMenuEntry = null;
        State.InvalidateWaveform(entry.FileName);
        await JS.InvokeVoidAsync("storyForgeAudio.recompute", _rootId, entry.FileName);
    }

    // ---- 轉檔成 OGG ----

    private void RequestConvert()
    {
        _convertError = State.ValidateFfmpeg();
        if (_convertError == null)
            _pendingConvert = State.PendingConvertFiles;
    }

    private async Task ConfirmConvert()
    {
        var files = _pendingConvert;
        _pendingConvert = null;
        if (files == null || files.Count == 0)
            return;

        await JS.InvokeVoidAsync("storyForgeAudio.stopAll");
        await State.RunConvertAsync(files);
    }

    private Task OnConvertProgress() => InvokeAsync(StateHasChanged);

    private void CloseConvertResult()
    {
        State.ClearConvertResult();
        State.Load();
        _entriesDirty = true;
    }

    // ---- 音量 column ----

    private RenderFragment RenderGain(AudioEntry entry)
    {
        var status = State.GetAdjustment(entry);
        if (status.Record is not { } record)
            return @<span></span>;

        var outdated = State.IsTargetOutdated(status);
        return @<span class="ab-gain" title="@GainTooltip(record, status.ExternallyChanged, outdated)">
            @FormatGainBadge(record)
            @if (status.ExternallyChanged)
            {
                <span class="ab-gain-warn">⚠ 外部已變更</span>
            }
            else if (outdated)
            {
                <span class="ab-gain-stale">↻</span>
            }
        </span>;
    }

    // "N -3.2 +1.5" = normalized (its gain), then the manual gain on top.
    private static string FormatGainBadge(AudioAdjustmentRecord record)
    {
        var parts = new List<string>();
        if (record.Normalize)
            parts.Add($"N {record.NormalizeGainDb:+0.0;-0.0;0.0}");
        if (record.ManualGainDb != 0)
            parts.Add($"{record.ManualGainDb:+0.0;-0.0}");
        return parts.Count == 0 ? "0 dB" : string.Join(" ", parts);
    }

    private string GainTooltip(AudioAdjustmentRecord record, bool externallyChanged, bool outdated)
    {
        var lines = new List<string>
        {
            $"原檔響度：{(record.MeasuredLufs is { } lufs ? $"{lufs:0.0} LUFS" : "無法量測")}，峰值 {FormatDb(record.OriginalPeakDb)} dBFS",
            record.Normalize ? $"標準化到 {record.NormalizeTargetLufs:0.#} LUFS：{record.NormalizeGainDb:+0.0;-0.0;0.0} dB" : "未標準化",
            $"手動增益：{record.ManualGainDb:+0.0;-0.0;0.0} dB",
            $"總增益：{record.TotalGainDb:+0.0;-0.0;0.0} dB",
        };
        if (externallyChanged)
            lines.Add("⚠ 檔案在工具外被換過了（或備份不見了）");
        else if (outdated)
            lines.Add($"↻ 目標響度已改成 {State.TargetLufs:0.#} LUFS，需要重新標準化");
        return string.Join("\n", lines);
    }

    private static string FormatDb(double? db) => db is { } value ? value.ToString("0.0") : "—";

    private static string GetOutcomeLabel(AudioGainOutcome outcome) => outcome switch
    {
        AudioGainOutcome.NeedsAdopt => "在工具外被換過（請用右鍵「調整音量」處理）",
        AudioGainOutcome.Unmeasurable => "量不出響度（請改用手動增益）",
        AudioGainOutcome.GainOutOfRange => "增益超出範圍（量測不可靠）",
        AudioGainOutcome.NoMeta => "沒有 .meta",
        AudioGainOutcome.LfsPointer => "Git LFS 指標檔（尚未下載）",
        AudioGainOutcome.Collision => "同名 .ogg 已存在",
        AudioGainOutcome.Failed => "失敗",
        _ => outcome.ToString(),
    };

    // ---- 調整音量 dialog ----

    private async Task OpenGainDialog(AudioEntry entry, bool adopt)
    {
        _contextMenuEntry = null;
        _adoptPromptEntry = null;

        if (State.CheckCanAdjust(entry) is { } error)
        {
            _gainMessage = error;
            return;
        }

        var status = State.GetAdjustment(entry);
        if (status.ExternallyChanged && !adopt)
        {
            _adoptPromptEntry = entry;
            return;
        }

        await JS.InvokeVoidAsync("storyForgeAudio.stopAll");
        var record = adopt ? null : status.Record;
        var dialog = new GainDialog
        {
            Entry = entry,
            Adopt = adopt,
            Url = State.GetOriginalUrl(entry, adopt),
            Normalize = record?.Normalize ?? false,
            ManualDb = record?.ManualGainDb ?? 0,
        };
        _gain = dialog;
        _selfRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("storyForgeAudio.previewBindKeys", _selfRef);

        if (record != null)
        {
            dialog.Loudness = new AudioLoudness { IntegratedLufs = record.MeasuredLufs, SamplePeakDb = record.OriginalPeakDb };
            return;
        }

        dialog.Measuring = true;
        StateHasChanged();
        var (loudness, measureError) = await State.MeasureAsync(entry);
        dialog.Measuring = false;
        if (loudness == null)
            dialog.MeasureError = measureError;
        dialog.Loudness = loudness;
    }

    private Task OpenGainDialogAdopting(AudioEntry entry) => OpenGainDialog(entry, true);

    private double? NormalizeGainOf(GainDialog dialog) =>
        dialog.Loudness?.IntegratedLufs is { } lufs ? State.TargetLufs - lufs : null;

    private bool IsNormalizeUsable(GainDialog dialog) =>
        dialog.Normalize && NormalizeGainOf(dialog) is { } gain && Math.Abs(gain) <= AudioGainProcessor.MaxNormalizeGainDb;

    private double TotalGainOf(GainDialog dialog) =>
        (IsNormalizeUsable(dialog) ? NormalizeGainOf(dialog)!.Value : 0) + dialog.ManualDb;

    private double PreviewGainOf(GainDialog dialog) => dialog.ListenOriginal ? 0 : TotalGainOf(dialog);

    private Task PushPreviewGain() =>
        _gain is { Playing: true } dialog
            ? JS.InvokeVoidAsync("storyForgeAudio.previewSetGain", PreviewGainOf(dialog)).AsTask()
            : Task.CompletedTask;

    private async Task OnGainNormalizeChanged(bool value)
    {
        if (_gain == null)
            return;
        _gain.Normalize = value;
        await PushPreviewGain();
    }

    private Task OnGainManualChanged(string? text) =>
        double.TryParse(text, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var value)
            ? OnGainManualChanged(value)
            : Task.CompletedTask;

    private async Task OnGainManualChanged(double value)
    {
        if (_gain == null)
            return;
        _gain.ManualDb = AudioGainProcessor.ClampManualGain(value);
        await PushPreviewGain();
    }

    private async Task SetListenOriginal(bool original)
    {
        if (_gain == null)
            return;
        _gain.ListenOriginal = original;
        await PushPreviewGain();
    }

    [JSInvokable]
    public async Task OnPreviewToggleAB()
    {
        if (_gain == null)
            return;
        await SetListenOriginal(!_gain.ListenOriginal);
        StateHasChanged();
    }

    private async Task TogglePreview()
    {
        if (_gain is not { } dialog)
            return;

        if (dialog.Playing)
        {
            dialog.Playing = false;
            await JS.InvokeVoidAsync("storyForgeAudio.previewStop");
            return;
        }

        dialog.Loading = true;
        dialog.PreviewError = null;
        StateHasChanged();
        try
        {
            dialog.Playing = await JS.InvokeAsync<bool>("storyForgeAudio.previewStart", dialog.Url, PreviewGainOf(dialog), State.Page.Volume);
            // The gain may have moved while the file was still loading.
            await PushPreviewGain();
        }
        catch (JSException e)
        {
            dialog.PreviewError = $"無法播放：{e.Message}";
        }
        finally
        {
            dialog.Loading = false;
        }
    }

    private async Task StopPreview()
    {
        await JS.InvokeVoidAsync("storyForgeAudio.previewStop");
        await JS.InvokeVoidAsync("storyForgeAudio.previewUnbindKeys");
    }

    private async Task CloseGainDialog()
    {
        _gain = null;
        await StopPreview();
    }

    private async Task ApplyGain()
    {
        if (_gain is not { } dialog)
            return;

        dialog.ApplyError = null;
        await JS.InvokeVoidAsync("storyForgeAudio.previewStop");
        dialog.Playing = false;

        var result = await RunWithOverlay($"轉檔中：{dialog.Entry.Name}",
            () => State.ApplyGainAsync(dialog.Entry, IsNormalizeUsable(dialog), dialog.ManualDb, dialog.Adopt));
        if (!result.Succeeded)
        {
            dialog.ApplyError = result.Message;
            return;
        }

        await CloseGainDialog();
        ReloadAfterWrite(dialog.Entry);
    }

    // Blazor only re-renders an event handler at its first yield and at its end — and ApplyGain's first
    // yield is the preview stop, before the write starts — so the overlay needs an explicit render.
    private async Task<AudioGainResult> RunWithOverlay(string message, Func<Task<AudioGainResult>> write)
    {
        _writingMessage = message;
        StateHasChanged();
        try
        {
            return await write();
        }
        finally
        {
            _writingMessage = null;
        }
    }

    private async Task RestoreFromDialog(AudioEntry entry)
    {
        await CloseGainDialog();
        RequestRestore(entry);
    }

    private void ReloadAfterWrite(AudioEntry written)
    {
        var message = State.StatusMessage;
        State.Load();
        State.SetStatusMessage(message);
        _entriesDirty = true;
        _ = FlashAsync(written.Name);
    }

    private async Task FlashAsync(string name)
    {
        var token = ++_flashToken;
        _flashName = name;
        await Task.Delay(2500);
        if (token != _flashToken)
            return;
        _flashName = null;
        await InvokeAsync(StateHasChanged);
    }

    // ---- 還原原檔 / 採用目前檔案 ----

    private void RequestRestore(AudioEntry entry)
    {
        _contextMenuEntry = null;
        if (State.ValidateFfmpeg() is { } error)
            _gainMessage = error;
        else
            _restoreEntry = entry;
    }

    private async Task ConfirmRestore()
    {
        if (_restoreEntry is not { } entry)
            return;

        await JS.InvokeVoidAsync("storyForgeAudio.stopAll");
        var overwrite = State.GetAdjustment(entry).ExternallyChanged;
        _restoreEntry = null;
        var result = await RunWithOverlay($"還原中：{entry.Name}", () => State.RestoreAsync(entry, overwrite));
        if (!result.Succeeded)
            _gainMessage = result.Message;
        ReloadAfterWrite(entry);
    }

    private void RequestForget(AudioEntry entry)
    {
        _contextMenuEntry = null;
        _forgetEntry = entry;
    }

    private void ConfirmForget()
    {
        if (_forgetEntry is { } entry)
            State.ForgetAdjustment(entry);
        _forgetEntry = null;
    }

    // ---- 標準化（批次） ----

    private void RequestNormalize()
    {
        _convertError = null;
        if (State.ValidateFfmpeg() is { } error)
            _gainMessage = error;
        else
            _pendingNormalize = true;
    }

    private void OnTargetChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var value))
            State.SetTargetLufs(Math.Round(Math.Clamp(value, -40, -5) * 2, MidpointRounding.AwayFromZero) / 2);
    }

    private async Task ConfirmNormalize()
    {
        _pendingNormalize = false;
        var files = State.PendingNormalizeFiles;
        if (files.Count == 0)
            return;

        await JS.InvokeVoidAsync("storyForgeAudio.stopAll");
        await State.RunNormalizeAsync(files);
    }

    private void CloseNormalizeResult()
    {
        State.ClearNormalizeResult();
        State.Load();
        _entriesDirty = true;
    }

    // ---- 孤兒記錄 ----

    private void RebindOrphan(string guid)
    {
        var target = State.Find(_orphanTargets.GetValueOrDefault(guid) ?? string.Empty);
        if (target == null)
            return;
        State.RebindOrphan(guid, target);
        _orphanTargets.Remove(guid);
        if (State.Adjustments.Orphans.Count == 0)
            _showOrphans = false;
    }

    private void DeleteOrphan(string guid)
    {
        State.DeleteOrphan(guid);
        _orphanTargets.Remove(guid);
        if (State.Adjustments.Orphans.Count == 0)
            _showOrphans = false;
    }

    public void Dispose()
    {
        State.OnConvertProgress -= OnConvertProgress;
        ReloadCoordinator.Unsubscribe(OnReload);
        _selfRef?.Dispose();
    }
}
