@using StoryForge.Core
@using StoryForge.Core.Audio
@using StoryForge.Web.Audio
@implements IDisposable
@inject StoryForge.Core.Graph.AppSettings AppSettings
@inject AudioWaveformCacheService WaveformCache
@inject ReloadCoordinator ReloadCoordinator
@inject IJSRuntime JS

@* One instance per tab (BGM / 音效), told which folder it browses via Category. Always mounted like every
   other panel (see Home.razor) — the canvases, scroll position and any in-progress note edit survive
   switching tabs. Waveform decoding, drawing, playback and column drag/resize all live in
   audio-browser.js; this component owns the file list, notes, remembered settings and the 轉檔 run. *@
<div class="ab-page" id="@_rootId" data-audio-root>
    <div class="ab-toolbar">
        <span class="ab-view-toggle">
            <button class="@(State.Page.ViewMode == AudioPageSettings.ViewList ? "active" : "")"
                    @onclick="() => SetViewMode(AudioPageSettings.ViewList)">列表</button>
            <button class="@(State.Page.ViewMode == AudioPageSettings.ViewCard ? "active" : "")"
                    @onclick="() => SetViewMode(AudioPageSettings.ViewCard)">卡片</button>
        </span>
        <label class="ab-check"><input type="checkbox" checked="@State.Page.AutoPlay" @onchange="OnAutoPlayChanged" /> 自動播放</label>
        <label class="ab-check"><input type="checkbox" checked="@State.Page.Loop" @onchange="OnLoopChanged" /> Loop</label>
        <label class="ab-slider">
            <span>音量</span>
            <input type="range" min="0" max="100" step="1" value="@((int)Math.Round(State.Page.Volume * 100))"
                   @oninput="OnVolumeInput" @onchange="OnSliderCommitted" />
            <span class="ab-slider-value">@((int)Math.Round(State.Page.Volume * 100))%</span>
        </label>
        @if (State.Page.ViewMode == AudioPageSettings.ViewCard)
        {
            <label class="ab-slider">
                <span>卡片大小</span>
                <input type="range" min="160" max="520" step="10" value="@((int)State.Page.CardSize)"
                       @oninput="OnCardSizeInput" @onchange="OnSliderCommitted" />
                <span class="ab-slider-value">@((int)State.Page.CardSize)px</span>
            </label>
        }
        <input class="ab-search" placeholder="搜尋檔名或備註..." @bind="_searchText" @bind:event="oninput" />
        <button @onclick="Rescan">重新掃描</button>
        <button @onclick="RequestConvert" disabled="@(State.PendingConvertFiles.Count == 0 || State.IsBusy)"
                title="把這個資料夾裡不是 .ogg 的音檔轉成 .ogg（原始檔會刪除，.meta 會保留給新檔案沿用）">
            轉檔成 OGG（@State.PendingConvertFiles.Count）
        </button>
        <button @onclick="RequestNormalize" disabled="@(State.IsBusy)"
                title="把還沒標準化（或標準化目標已變更）的檔案，從原檔以固定增益拉到目標響度（@State.TargetLufs.ToString("0.#") LUFS）">
            標準化（@State.PendingNormalizeFiles.Count）
        </button>
        @if (State.Adjustments.Orphans.Count > 0)
        {
            <button class="ab-warn-button" @onclick="() => _showOrphans = true"
                    title="AudioAdjustments.json 裡找不到對應檔案（GUID）的調整記錄">
                孤兒記錄（@State.Adjustments.Orphans.Count）
            </button>
        }
        <span class="ab-status">@State.StatusMessage</span>
    </div>

    <div class="ab-body">
        @if (State.Entries.Count == 0)
        {
            <div class="ab-empty">這個資料夾（Assets/@AudioAssetScanner.GetFolderRelativePath(Category)）裡沒有音檔</div>
        }
        else if (State.Page.ViewMode == AudioPageSettings.ViewList)
        {
            <table class="ab-grid" style="width:@(TableWidth)px">
                <thead>
                    <tr id="@_headerRowId">
                        @foreach (var col in State.Page.Columns)
                        {
                            <th @key="col.Key" data-key="@col.Key" style="width:@(col.Width)px"
                                title="@(col.Key == "wave" ? "拖曳可調整欄位順序" : "點擊可排序，拖曳可調整欄位順序")"
                                @onclick="() => OnColumnHeaderClicked(col.Key)">
                                <span class="ab-th-label">@GetColumnLabel(col.Key)</span>
                                @if (State.Page.SortColumn == col.Key)
                                {
                                    <span class="ab-sort-indicator">@(State.Page.SortDescending ? "▼" : "▲")</span>
                                }
                                <span class="ab-col-resize" title="拖曳調整欄寬"></span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in VisibleEntries)
                    {
                        <tr @key="entry.FileName" class="@(entry.Name == _flashName ? "ab-flash" : null)" @oncontextmenu="e => OpenContextMenu(e, entry)" @oncontextmenu:preventDefault="true">
                            @foreach (var col in State.Page.Columns)
                            {
                                <td @key="col.Key" class="ab-cell-@col.Key">@RenderCell(entry, col.Key)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="ab-cards">
                @foreach (var entry in VisibleEntries)
                {
                    <div class="ab-card @(entry.Name == _flashName ? "ab-flash" : null)" @key="entry.FileName" style="width:@(State.Page.CardSize)px"
                         @oncontextmenu="e => OpenContextMenu(e, entry)" @oncontextmenu:preventDefault="true">
                        @RenderWave(entry, "ab-wave-card")
                        <div class="ab-card-title" title="@entry.FileName">@entry.Name</div>
                        <div class="ab-card-meta">
                            <span class="ab-card-duration">@FormatDuration(entry)</span>
                            @RenderGain(entry)
                            <span class="ab-card-minor">@entry.Format · @FormatSize(entry.SizeBytes)</span>
                        </div>
                        <textarea class="ab-card-note" placeholder="這個音檔的用途／氣氛（給 AI 參考）"
                                  value="@State.GetNote(entry)" @onchange="e => SaveNote(entry, e.Value?.ToString())"></textarea>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (_contextMenuEntry is { } menuEntry)
{
    <div class="ab-context-menu-backdrop" @onclick="CloseContextMenu"
         @oncontextmenu="CloseContextMenu" @oncontextmenu:preventDefault="true"></div>
    <div class="ab-context-menu" style="left:@(_contextMenuX)px; top:@(_contextMenuY)px">
        <button @onclick="() => CopyName(menuEntry)">複製檔名</button>
        <button @onclick="() => RefreshWaveform(menuEntry)">刷新音紋圖</button>
        <button @onclick="() => OpenGainDialog(menuEntry, false)" disabled="@State.IsBusy">調整音量…</button>
        @if (State.GetAdjustment(menuEntry) is { Record: not null } menuStatus)
        {
            <button @onclick="() => RequestRestore(menuEntry)" disabled="@State.IsBusy">還原原檔…</button>
            @if (menuStatus.ExternallyChanged)
            {
                <button @onclick="() => RequestForget(menuEntry)" disabled="@State.IsBusy">採用目前檔案（清除調整記錄）…</button>
            }
        }
    </div>
}

@if (_convertError != null)
{
    <div class="ab-modal-backdrop">
        <div class="ab-modal">
            <h3>無法轉檔</h3>
            <p class="ab-pre">@_convertError</p>
            <div class="ab-modal-actions"><button @onclick="() => _convertError = null">關閉</button></div>
        </div>
    </div>
}

@if (_pendingConvert != null)
{
    <div class="ab-modal-backdrop">
        <div class="ab-modal">
            <h3>轉檔成 OGG</h3>
            <p>以下 @_pendingConvert.Count 個檔案會用 ffmpeg 轉成 .ogg：</p>
            <div class="ab-result-list">
                @foreach (var file in _pendingConvert)
                {
                    <div class="ab-result-row">@file.FileName</div>
                }
            </div>
            <p class="ab-warning">轉檔成功後原始檔會被刪除（無法復原，只能靠 Unity 專案的 git 還原）。原始檔的 .meta 會改名給新的 .ogg 沿用，GUID 不變。</p>
            <div class="ab-modal-actions">
                <button @onclick="ConfirmConvert">開始轉檔</button>
                <button @onclick="() => _pendingConvert = null">取消</button>
            </div>
        </div>
    </div>
}

@if ((State.IsConvertRunning || State.IsNormalizeRunning) && State.ConvertProgress is { } progress)
{
    <div class="ab-modal-backdrop">
        <div class="ab-modal">
            <h3>@(State.IsNormalizeRunning ? "標準化中…" : "轉檔中…")</h3>
            <div class="ab-progress-bar"><div class="ab-progress-fill" style="width:@(progress.Total == 0 ? 0 : 100.0 * progress.Processed / progress.Total)%"></div></div>
            <div class="ab-progress-text">@progress.Processed / @progress.Total — @progress.CurrentFileName</div>
            <div class="ab-modal-actions">
                <button @onclick="State.CancelConvert" disabled="@State.IsCancelRequested">
                    @(State.IsCancelRequested ? "等目前這個檔案處理完…" : "取消")
                </button>
            </div>
        </div>
    </div>
}

@if (!State.IsConvertRunning && State.ConvertResult is { } result)
{
    <div class="ab-modal-backdrop">
        <div class="ab-modal">
            <h3>@(result.Cancelled ? "轉檔已取消" : "轉檔完成")</h3>
            <p>轉換 @result.Converted、跳過 @result.Skipped、同名衝突 @result.Collisions（原始檔已移到 08.Audio/Collision）、失敗 @result.Failed</p>
            @if (result.Failures.Count > 0)
            {
                <div class="ab-result-list">
                    @foreach (var failure in result.Failures)
                    {
                        <div class="ab-result-row"><b>@failure.FileName</b><div class="ab-pre ab-failure">@failure.Error</div></div>
                    }
                </div>
            }
            <div class="ab-modal-actions">
                @if (result.LogPath != null)
                {
                    <button @onclick="() => State.OpenLogFile(result.LogPath)">開啟記錄檔</button>
                }
                <button @onclick="CloseConvertResult">關閉</button>
            </div>
        </div>
    </div>
}

@if (_gainMessage != null)
{
    <div class="ab-modal-backdrop">
        <div class="ab-modal">
            <h3>無法調整音量</h3>
            <p class="ab-pre">@_gainMessage</p>
            <div class="ab-modal-actions"><button @onclick="() => _gainMessage = null">關閉</button></div>
        </div>
    </div>
}

@if (_adoptPromptEntry is { } adoptEntry)
{
    <div class="ab-modal-backdrop">
        <div class="ab-modal">
            <h3>檔案在工具外被換過了</h3>
            <p><b>@adoptEntry.FileName</b> 和上次調整音量時寫入的檔案不同（或備份原檔不見了）。可能是換了新版素材，也可能是切換了 git 版本。</p>
            <p>要把<b>目前的檔案</b>當成新的原檔來調整嗎？套用時會刪除舊的備份和調整記錄，改用目前的檔案當原檔。</p>
            <div class="ab-modal-actions">
                <button @onclick="() => OpenGainDialogAdopting(adoptEntry)">當成新原檔，繼續調整</button>
                <button @onclick="() => _adoptPromptEntry = null">取消</button>
            </div>
        </div>
    </div>
}

@if (_gain is { } gain)
{
    var record = gain.Adopt ? null : State.GetAdjustment(gain.Entry).Record;
    var normalizeGain = NormalizeGainOf(gain);
    var normalizeAvailable = normalizeGain is { } ng && Math.Abs(ng) <= AudioGainProcessor.MaxNormalizeGainDb;
    var total = TotalGainOf(gain);
    var predictedPeak = gain.Loudness?.SamplePeakDb is { } peak ? peak + total : (double?)null;
    <div class="ab-modal-backdrop">
        <div class="ab-modal ab-gain-modal">
            <h3>調整音量：@gain.Entry.Name</h3>
            <div class="ab-gain-grid">
                <span>原檔</span>
                <span>
                    @(record != null ? $"備份（AudioOriginals，.{record.OriginalExtension}）" : $"目前的檔案（.{gain.Entry.Format}）")
                    @if (!gain.Entry.IsOgg) { <span class="ab-warning">　套用時會轉成 .ogg</span> }
                </span>

                <span>原檔響度</span>
                <span>
                    @if (gain.Measuring) { <text>量測中…</text> }
                    else if (gain.MeasureError != null) { <span class="ab-warning">量測失敗：@gain.MeasureError</span> }
                    else if (gain.Loudness is { } loud)
                    {
                        @(loud.IntegratedLufs is { } lufs ? $"{lufs:0.0} LUFS" : "無法量測（太短或太安靜）")
                        @($"　峰值 {FormatDb(loud.SamplePeakDb)} dBFS")
                    }
                </span>

                <span>標準化</span>
                <span>
                    <label class="ab-check" title="@(normalizeAvailable ? "" : "量不出可靠的整合響度，只能用手動增益")">
                        <input type="checkbox" checked="@(gain.Normalize && normalizeAvailable)" disabled="@(!normalizeAvailable)"
                               @onchange="e => OnGainNormalizeChanged(e.Value is true)" />
                        到 @State.TargetLufs.ToString("0.#") LUFS
                    </label>
                    @if (normalizeGain is { } g)
                    {
                        <span class="ab-gain-muted">　（@(normalizeAvailable ? $"{g:+0.0;-0.0;0.0} dB" : $"需要 {g:+0.0;-0.0} dB，超出 ±{AudioGainProcessor.MaxNormalizeGainDb} dB，不可靠")）</span>
                    }
                </span>

                <span>手動增益</span>
                <span class="ab-gain-manual">
                    <input type="range" min="@AudioGainProcessor.MinManualGainDb" max="@AudioGainProcessor.MaxManualGainDb" step="0.5"
                           value="@gain.ManualDb.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           @oninput="e => OnGainManualChanged(e.Value?.ToString())" />
                    <input type="number" min="@AudioGainProcessor.MinManualGainDb" max="@AudioGainProcessor.MaxManualGainDb" step="0.5"
                           value="@gain.ManualDb.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           @onchange="e => OnGainManualChanged(e.Value?.ToString())" /> dB
                    <button class="ab-small-button" @onclick="() => OnGainManualChanged(0)">歸零</button>
                </span>

                <span>總增益</span>
                <span><b>@($"{total:+0.0;-0.0;0.0}") dB</b></span>

                <span>處理後峰值</span>
                <span>
                    @if (predictedPeak is { } pp)
                    {
                        <text>@FormatDb(pp) dBFS</text>
                        @if (pp > 0)
                        {
                            <span class="ab-warning">　⚠ 會削波約 @pp.ToString("0.0") dB</span>
                        }
                    }
                    else { <text>—</text> }
                </span>
            </div>

            <div class="ab-gain-preview">
                <button @onclick="TogglePreview" disabled="@(gain.Loading)">
                    @(gain.Loading ? "載入中…" : gain.Playing ? "■ 停止" : "▶ 試聽")
                </button>
                <span class="ab-view-toggle">
                    <button class="@(gain.ListenOriginal ? "active" : "")" @onclick="() => SetListenOriginal(true)">A 原檔</button>
                    <button class="@(gain.ListenOriginal ? "" : "active")" @onclick="() => SetListenOriginal(false)">B 調整後</button>
                </span>
                <span class="ab-gain-muted">空白鍵切換 A/B；試聽音量跟著分頁的音量滑桿</span>
            </div>
            @if (gain.PreviewError != null) { <p class="ab-warning">@gain.PreviewError</p> }

            <p class="ab-warning">套用會從原檔重新編碼並覆蓋 Assets 裡的檔案（第一次調整時會先把原檔備份到 Unity 專案的 AudioOriginals/）。</p>
            @if (gain.ApplyError != null) { <p class="ab-warning ab-pre">@gain.ApplyError</p> }

            <div class="ab-modal-actions">
                @if (record != null)
                {
                    <button class="ab-left-action" @onclick="() => RestoreFromDialog(gain.Entry)" disabled="@State.IsBusy">還原原檔…</button>
                }
                <button @onclick="ApplyGain" disabled="@(gain.Measuring || gain.MeasureError != null || State.IsBusy)">
                    @(State.IsGainWriting ? "套用中…" : "套用")
                </button>
                <button @onclick="CloseGainDialog" disabled="@State.IsGainWriting">取消</button>
            </div>
        </div>
    </div>
}

@if (_writingMessage != null)
{
    <div class="ab-modal-backdrop ab-writing-backdrop">
        <div class="ab-modal ab-writing">
            <div class="ab-spinner"></div>
            <div>
                <div><b>@_writingMessage</b></div>
                <div class="ab-gain-muted">從原檔重新編碼並覆蓋 Assets 裡的檔案，請稍候…</div>
            </div>
        </div>
    </div>
}

@if (_restoreEntry is { } restoreEntry)
{
    var restoreStatus = State.GetAdjustment(restoreEntry);
    <div class="ab-modal-backdrop">
        <div class="ab-modal">
            <h3>還原原檔：@restoreEntry.Name</h3>
            <p>
                會把備份的原檔（.@restoreStatus.Record?.OriginalExtension）寫回 Assets
                @(restoreStatus.Record?.OriginalExtension == "ogg" ? "（原封不動複製回去）" : "（重新編碼成 .ogg，增益 0）")，
                然後刪除備份和這個檔案的調整記錄。
            </p>
            @if (restoreStatus.ExternallyChanged)
            {
                <p class="ab-warning">⚠ 這個檔案在工具外被換過了，還原會用<b>舊的原檔</b>蓋掉目前的檔案。</p>
            }
            <div class="ab-modal-actions">
                <button @onclick="ConfirmRestore" disabled="@State.IsBusy">@(State.IsGainWriting ? "還原中…" : "還原")</button>
                <button @onclick="() => _restoreEntry = null" disabled="@State.IsGainWriting">取消</button>
            </div>
        </div>
    </div>
}

@if (_forgetEntry is { } forgetEntry)
{
    <div class="ab-modal-backdrop">
        <div class="ab-modal">
            <h3>採用目前檔案：@forgetEntry.Name</h3>
            <p>把 Assets 裡目前的檔案當成正確版本：刪除舊的備份原檔和這個檔案的調整記錄，檔案本身不會被改動。</p>
            <div class="ab-modal-actions">
                <button @onclick="ConfirmForget">採用</button>
                <button @onclick="() => _forgetEntry = null">取消</button>
            </div>
        </div>
    </div>
}

@if (_pendingNormalize)
{
    var pendingNormalize = State.PendingNormalizeFiles;
    <div class="ab-modal-backdrop">
        <div class="ab-modal">
            <h3>標準化</h3>
            <p>
                目標響度
                <input class="ab-number" type="number" step="0.5" min="-40" max="-5"
                       value="@State.TargetLufs.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       @onchange="OnTargetChanged" /> LUFS
                <span class="ab-gain-muted">（BGM 和音效各自一個值，存在 Unity 專案的 @AudioAdjustmentSettings.FileName，所有人共用）</span>
            </p>
            <p>以下 @pendingNormalize.Count 個檔案還沒標準化，或標準化時的目標值和目前不同。每個檔案會從原檔以固定增益拉到目標響度，已設定的手動增益會保留：</p>
            <div class="ab-result-list">
                @foreach (var file in pendingNormalize)
                {
                    <div class="ab-result-row">@file.FileName</div>
                }
            </div>
            <p class="ab-warning">會重新編碼並覆蓋 Assets 裡的檔案（原檔會先備份到 AudioOriginals/）。在工具外被換過、量不出響度、增益超出 ±@AudioGainProcessor.MaxNormalizeGainDb dB 的檔案會跳過並列出。</p>
            <div class="ab-modal-actions">
                <button @onclick="ConfirmNormalize" disabled="@(pendingNormalize.Count == 0)">開始標準化</button>
                <button @onclick="() => _pendingNormalize = false">取消</button>
            </div>
        </div>
    </div>
}

@if (!State.IsNormalizeRunning && State.NormalizeResult is { } normalizeResult)
{
    <div class="ab-modal-backdrop">
        <div class="ab-modal">
            <h3>@(normalizeResult.Cancelled ? "標準化已取消" : "標準化完成")</h3>
            <p>完成 @normalizeResult.Applied、跳過 @normalizeResult.Skipped.Count、失敗 @normalizeResult.Failures.Count</p>
            @if (normalizeResult.Skipped.Count + normalizeResult.Failures.Count > 0)
            {
                <div class="ab-result-list">
                    @foreach (var group in normalizeResult.Skipped.Concat(normalizeResult.Failures).GroupBy(r => r.Outcome))
                    {
                        <div class="ab-result-group">@GetOutcomeLabel(group.Key)（@group.Count()）</div>
                        @foreach (var item in group)
                        {
                            <div class="ab-result-row"><b>@item.FileName</b><div class="ab-pre ab-failure">@item.Message</div></div>
                        }
                    }
                </div>
            }
            <div class="ab-modal-actions">
                <button @onclick="CloseNormalizeResult">關閉</button>
            </div>
        </div>
    </div>
}

@if (_showOrphans)
{
    var unmanaged = State.Entries.Where(e => State.GetAdjustment(e) is { Guid: not null, Record: null }).ToList();
    <div class="ab-modal-backdrop">
        <div class="ab-modal">
            <h3>孤兒記錄</h3>
            <p>這些調整記錄對應的檔案（依 .meta GUID）已經不在資料夾裡了。檔案真的刪掉了就刪除記錄；如果檔案被刪掉後重新加入（GUID 變了），可以把記錄接到它身上。</p>
            <div class="ab-result-list">
                @foreach (var orphan in State.Adjustments.Orphans)
                {
                    <div class="ab-result-row ab-orphan-row">
                        <span class="ab-orphan-name" title="GUID @orphan.Guid"><b>@orphan.Record.LastKnownName</b>
                            <span class="ab-gain-muted">.@orphan.Record.OriginalExtension　@FormatGainBadge(orphan.Record)</span></span>
                        <select @onchange="e => _orphanTargets[orphan.Guid] = e.Value?.ToString() ?? string.Empty">
                            <option value="">（選擇要接上的檔案）</option>
                            @foreach (var candidate in unmanaged)
                            {
                                <option value="@candidate.FileName" selected="@(_orphanTargets.GetValueOrDefault(orphan.Guid) == candidate.FileName)">@candidate.FileName</option>
                            }
                        </select>
                        <button class="ab-small-button" disabled="@string.IsNullOrEmpty(_orphanTargets.GetValueOrDefault(orphan.Guid))"
                                @onclick="() => RebindOrphan(orphan.Guid)">接上</button>
                        <button class="ab-small-button" @onclick="() => DeleteOrphan(orphan.Guid)">刪除記錄</button>
                    </div>
                }
            </div>
            <div class="ab-modal-actions">
                <button @onclick="() => _showOrphans = false">關閉</button>
            </div>
        </div>
    </div>
}

