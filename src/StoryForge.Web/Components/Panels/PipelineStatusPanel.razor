    private void ToggleAllVisibleRows(ChangeEventArgs e)
    {
        var check = e.Value is bool b && b;
        foreach (var row in FilteredRows)
        {
            if (check)
                _selectedNames.Add(row.PlayscriptName);
            else
                _selectedNames.Remove(row.PlayscriptName);
        }
    }

    // Driven by @onclick rather than @onchange — only MouseEventArgs (not ChangeEventArgs) carries ShiftKey,
    // which the range-select behavior below needs. @onclick:preventDefault on the checkbox (see markup) stops
    // the browser's own native check/uncheck from ever happening on click — without it, a shift-click that
    // recomputes a row back to the SAME state it already had (e.g. re-checking a row that's already checked)
    // is, from Blazor's own diffing perspective, "no change" to the rendered checked="@expr" attribute, so
    // Blazor never re-pushes it to the DOM — but the browser had already toggled that checkbox's native state
    // as the click's default action before this handler even ran, leaving it visually wrong (unchecked) while
    // _selectedNames still correctly has it. Suppressing the native toggle entirely makes the server-rendered
    // checked="@_selectedNames.Contains(...)" the only thing that ever changes the checkbox's displayed state.
    private void OnRowCheckboxClicked(PipelineStatusRow row, MouseEventArgs e)
    {
        var newState = !_selectedNames.Contains(row.PlayscriptName);

        if (e.ShiftKey && _lastClickedRowName != null)
        {
            var visibleNames = FilteredRows.Select(r => r.PlayscriptName).ToList();
            var anchorIndex = visibleNames.IndexOf(_lastClickedRowName);
            var targetIndex = visibleNames.IndexOf(row.PlayscriptName);

            if (anchorIndex >= 0 && targetIndex >= 0)
            {
                var from = Math.Min(anchorIndex, targetIndex);
                var to = Math.Max(anchorIndex, targetIndex);
                for (var i = from; i <= to; i++)
                {
                    if (_lastClickedRowState)
                        _selectedNames.Add(visibleNames[i]);
                    else
                        _selectedNames.Remove(visibleNames[i]);
                }

                // Deliberately doesn't move the anchor — see _lastClickedRowName's own comment.
                return;
            }
        }

        if (newState)
            _selectedNames.Add(row.PlayscriptName);
        else
            _selectedNames.Remove(row.PlayscriptName);

        _lastClickedRowName = row.PlayscriptName;
        _lastClickedRowState = newState;
    }

