    private async Task ExportCSharp()
    {
        // Names State drops up front for having no local content at all never got queued, so there's
        // nothing left in the batch to report a failure for them — remove them from the selection too,
        // rather than leaving them checked (and invisible/unreachable the moment the current chapter
        // filter/search no longer shows them) only to trigger the exact same drop again next time.
        var excluded = await State.StartCSharpExportAsync(_selectedNames);
        foreach (var name in excluded)
            _selectedNames.Remove(name);
    }

