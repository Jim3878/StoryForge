@code {
    private sealed class ColumnDef
    {
        public string Key = string.Empty;
        public string Label = string.Empty;
    }

    // Draggable order — matches DataGridView's AllowUserToOrderColumns from the original tool. A plain
    // list (not persisted) since this is a cosmetic per-session preference, not data.
    private List<ColumnDef> _columns = new()
    {
        new() { Key = "chapter", Label = "章節" },
        new() { Key = "name", Label = "劇本名稱" },
        new() { Key = "ldtk", Label = "LDtk" },
        new() { Key = "graph", Label = "流程圖" },
        new() { Key = "localScript", Label = "本地劇本" },
        new() { Key = "sheetDir", Label = "Sheet目錄" },
        new() { Key = "sheetFile", Label = "Sheet檔案" },
        new() { Key = "csharp", Label = "C#" },
    };
    private DotNetObjectReference<PipelineStatusPanel>? _selfRef;

    private string _searchText = string.Empty;

    // Row-level selection for "建立劇本檔" and "下載Sheet劇本" — independent of the chapter filter above,
    // which only controls which rows are visible/selectable here. Deliberately not cleared when a row is
    // hidden by the chapter filter or search box, so a selection made before narrowing the view still
    // counts once the view widens again.
    private readonly HashSet<string> _selectedNames = new();

    // Transient feedback shown next to the "複製結果" button after a click — cleared whenever the results
    // dialog is dismissed so it never lingers into the next batch's dialog.
    private string? _copyFeedback;

    // "上傳補完到Sheet"'s pre-flight confirm list — a snapshot of _selectedNames taken when the button is
    // clicked, shown in a plain name list (no per-row detail; a chapter-sized batch is too long to read a
    // categorized breakdown of) so the user can back out before anything is actually sent. Purely panel-local
    // UI state: State only needs to know about the batch once the user has actually confirmed it.
    private List<string>? _pendingUploadNames;
    private string? _uploadCopyFeedback;
    private string? _cSharpExportCopyFeedback;

    // Shift-click range-select anchor — the last row a plain (non-shift) checkbox click landed on, and the
    // state that click left it in. A shift-click applies that same state to every row between the anchor
    // and the shift-clicked row (inclusive), regardless of what state those rows or the shift-clicked row
    // itself were in beforehand — not a per-row toggle. Only ever moved by a plain click; a shift-click never
    // becomes the new anchor, so repeated shift-clicks keep extending/shrinking the range from the same
    // fixed starting point (standard Explorer/Gmail-style range select).
    private string? _lastClickedRowName;
    private bool _lastClickedRowState;

    // Column header click-to-sort. Null = unsorted (natural PlaylistPipelineComparer order). Independent of
    // the header's own drag-to-reorder (storyForgeColumnSort.init/SortableJS) — a plain click (no pointer
    // movement) never starts a SortableJS drag, so both gestures coexist on the same <th> without conflict.
    private string? _sortColumn;
    private bool _sortDescending;

    // Right-click context menu — always targets whatever row the cursor was over when it opened, entirely
    // independent of the checkbox selection above (mirrors the original WinForms grid's own single-row
    // CurrentRow-based context menu, which predates this port's checkbox multi-select concept). Screen
    // coordinates (MouseEventArgs.Client{X,Y}) pair with position:fixed in the menu's own CSS, so no scroll
    // offset math is needed.
    private PipelineStatusRow? _contextMenuRow;
    private double _contextMenuX;
    private double _contextMenuY;

    // Chapters newly seen on a refresh default to selected so a refresh never silently hides new data —
    // matching the original tool's own ChapterFilterSettings behavior — but a chapter the user has
    // manually deselected stays deselected across refreshes (tracked via _knownChapters).
    private HashSet<string> _selectedChapters = new();
    private HashSet<string> _knownChapters = new();

    // Loaded once at startup — null means no prior selection was ever saved, so the very first
    // population falls back to "default everything to selected" instead of an empty filter. Persists
    // across circuit restarts/page reloads (unlike the two HashSets above), matching the original tool.
    private readonly HashSet<string>? _persistedSelectedChapters =
        ChapterFilterSettings.LoadOrNull() is { } persisted
            ? new HashSet<string>(persisted.SelectedChapters, StringComparer.Ordinal)
            : null;

    private List<string> AllChapters =>
        State.Rows.Select(r => r.Chapter).Distinct().OrderBy(c => c, NaturalStringComparer.Instance).ToList();

    private bool AllSelected => AllChapters.Count > 0 && AllChapters.All(_selectedChapters.Contains);

    private IEnumerable<PipelineStatusRow> FilteredRows
    {
        get
        {
            var rows = State.Rows
                .Where(r => _selectedChapters.Contains(r.Chapter))
                .Where(r => string.IsNullOrWhiteSpace(_searchText) ||
                            r.PlayscriptName.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

            return ApplySort(rows);
        }
    }

    // A boolean/check column sorts unchecked-before-checked ascending (false < true) — grouping "still
    // missing this" rows together is the actual point of sorting a check column at all. Ties keep their
    // original relative order either direction (OrderBy/OrderByDescending are both stable sorts), so sorting
    // by a mostly-uniform column like 章節 doesn't scramble the secondary 劇本名稱 ordering rows already had.
    private IEnumerable<PipelineStatusRow> ApplySort(IEnumerable<PipelineStatusRow> rows)
    {
        if (_sortColumn == null)
            return rows;

        IOrderedEnumerable<PipelineStatusRow> OrderedBy<TKey>(
            Func<PipelineStatusRow, TKey> keySelector, IComparer<TKey>? comparer = null) =>
            _sortDescending
                ? rows.OrderByDescending(keySelector, comparer)
                : rows.OrderBy(keySelector, comparer);

        return _sortColumn switch
        {
            "chapter" => OrderedBy(r => r.Chapter, NaturalStringComparer.Instance),
            "name" => OrderedBy(r => r.PlayscriptName, NaturalStringComparer.Instance),
            "ldtk" => OrderedBy(r => r.IsOnLdtk),
            "graph" => OrderedBy(r => r.IsOnGraph),
            "localScript" => OrderedBy(r => r.HasLocalScriptFile),
            "sheetDir" => OrderedBy(r => r.IsOnSheet),
            "sheetFile" => OrderedBy(r => r.HasSheetFile),
            "csharp" => OrderedBy(r => r.IsOnCSharp),
            _ => rows,
        };
    }

    private void OnColumnHeaderClicked(string columnKey)
    {
        if (_sortColumn == columnKey)
            _sortDescending = !_sortDescending;
        else
        {
            _sortColumn = columnKey;
            _sortDescending = false;
        }
    }

    private double SheetScriptProgressPercent =>
