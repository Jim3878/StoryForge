    private void SyncChapterSelection()
    {
        var isFirstPopulation = _knownChapters.Count == 0;

        foreach (var chapter in AllChapters)
        {
            if (!_knownChapters.Add(chapter))
                continue;

            // The very first time chapters are ever seen this run, respect a previously-saved selection
            // if there is one, instead of defaulting everything to selected. A chapter that shows up later
            // (a subsequent refresh finds something new) always defaults to selected regardless, so a
            // refresh never silently hides data the user hasn't already chosen to filter out themselves.
            if (isFirstPopulation && _persistedSelectedChapters != null)
            {
                if (_persistedSelectedChapters.Contains(chapter))
                    _selectedChapters.Add(chapter);
            }
            else
            {
                _selectedChapters.Add(chapter);
            }
        }
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        var check = e.Value is bool b && b;
        _selectedChapters = check ? AllChapters.ToHashSet() : new HashSet<string>();
        SaveChapterSelection();
    }

    private void ToggleChapter(string chapter, ChangeEventArgs e)
    {
        var check = e.Value is bool b && b;
        if (check)
            _selectedChapters.Add(chapter);
        else
            _selectedChapters.Remove(chapter);
        SaveChapterSelection();
    }

    private void SaveChapterSelection()
    {
        new ChapterFilterSettings { SelectedChapters = _selectedChapters.ToList() }.Save();
    }

    private static string GetCellText(PipelineStatusRow row, string key) => key switch
    {
        "chapter" => row.Chapter,
        "name" => row.PlayscriptName,
        "ldtk" => row.IsOnLdtk ? "✔" : "",
        "graph" => row.IsOnGraph ? "✔" : "",
        "localScript" => row.HasLocalScriptFile ? "✔" : "",
        "sheetDir" => row.IsOnSheet ? "✔" : "",
        "sheetFile" => row.HasSheetFile ? "✔" : "",
        "csharp" => row.IsOnCSharp ? "✔" : "",
        _ => "",
    };

    private static string GetCellClass(string key) => key switch
    {
        "name" => "ps-name",
        "ldtk" or "graph" or "localScript" or "sheetDir" or "sheetFile" or "csharp" => "ps-check",
        _ => "",
    };

    // "Sheet目錄" = listed in the index sheet at all. "Sheet檔案" = that listing already has its own
    // dedicated spreadsheet (a real link) and isn't marked "空" in that chapter tab's own empty-check column.
    // "本地劇本" checks disk only, independent of "流程圖" — a row with this checked but not "流程圖" means
    // the .md file is a leftover from a node that no longer exists on the graph.
    private static string GetCellTitle(string key) => key switch
    {
        "localScript" => "本機是否已有這個劇本名稱的 .md 劇本檔（與流程圖節點是否存在無關）",
        "sheetDir" => "是否列在 Sheet 索引中",
        "sheetFile" => "是否已有自己的 GoogleSheet 分頁，且未被標記為空",
        _ => "",
    };
