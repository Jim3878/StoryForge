    protected override void OnInitialized()
    {
        ReloadCoordinator.Subscribe(OnReload);
        State.OnSheetScriptProgress += OnSheetScriptProgress;
        State.OnUploadProgress += OnUploadProgress;
        State.OnCSharpExportProgress += OnCSharpExportProgress;
    }

    // Deferred to firstRender rather than done in OnInitialized: GraphEditorState's model (this panel's
    // 流程圖 column source, via PipelineStatusState.Refresh -> GetPlayscriptIdentities) is only populated by
    // FlowGraphPanel's own LoadAndInit, which itself runs from OnAfterRenderAsync — OnInitialized for every
    // always-mounted panel (see Home.razor) runs before any of them reach OnAfterRenderAsync, so refreshing
    // here instead would always see an empty/not-yet-loaded graph. Relies on Home.razor mounting
    // <FlowGraphPanel /> before <PipelineStatusPanel /> so its OnAfterRenderAsync (and thus LoadAndInit's
    // synchronous LoadGraph() call, which runs before that method's own first await) has already populated
    // the model by the time this one runs.
    //
    // Re-armed on every render (init() itself destroys any previous instance first) rather than only on
    // firstRender — a reorder's own StateHasChanged() re-renders the header row, and the freshly-rendered
    // <tr> needs SortableJS wired to it again for the next drag to work.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            State.Refresh();
            SyncChapterSelection();
            StateHasChanged();
        }

        _selfRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("storyForgeColumnSort.init", "ps-header-row", _selfRef);
    }

    // Wired to the global 讀取 toolbar button (MainLayout) via ReloadCoordinator, same as the other three
    // always-mounted panels — previously missing here, which meant 讀取 silently left this tab showing
    // stale data and the user had to remember to also press this tab's own 重新整理 button every time.
    private async Task OnReload()
    {
        State.Refresh();
        SyncChapterSelection();
        await InvokeAsync(StateHasChanged);
    }

    // Called by column-sort.js after a drag completes — SortableJS already physically moved the <th> in
    // the DOM itself; this just updates the C# source of truth to match and re-renders from it, so a
    // stray external DOM mutation never drifts out of sync with what Blazor thinks the column order is.
    [JSInvokable]
    public void OnColumnReordered(int oldIndex, int newIndex)
    {
        if (oldIndex < 0 || oldIndex >= _columns.Count || newIndex < 0 || newIndex >= _columns.Count)
            return;

        var column = _columns[oldIndex];
        _columns.RemoveAt(oldIndex);
        _columns.Insert(newIndex, column);
        StateHasChanged();
    }

    public void Dispose()
    {
        ReloadCoordinator.Unsubscribe(OnReload);
        State.OnSheetScriptProgress -= OnSheetScriptProgress;
        State.OnUploadProgress -= OnUploadProgress;
        State.OnCSharpExportProgress -= OnCSharpExportProgress;
        _selfRef?.Dispose();
    }

