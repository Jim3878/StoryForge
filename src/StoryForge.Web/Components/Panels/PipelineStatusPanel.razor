@using StoryForge.Core
@using StoryForge.Core.Pipeline
@using StoryForge.Web.Pipeline
@implements IDisposable
@inject PipelineStatusState State
@inject IJSRuntime JS
@inject ReloadCoordinator ReloadCoordinator
@inject StoryForge.Web.FlowGraphFocusCoordinator FlowGraphFocusCoordinator

<div class="ps-page">
    <div class="ps-toolbar">
        <button @onclick="Refresh">重新整理</button>
        <button @onclick="BuildNodeFiles">建立劇本檔</button>
        <button @onclick="DownloadSheetScripts" disabled="@State.IsSheetScriptDownloadRunning">下載Sheet劇本</button>
        <button @onclick="RequestUpload" disabled="@(State.IsUploadRunning || _selectedNames.Count == 0)">上傳補完到Sheet</button>
        <button @onclick="ExportCSharp" disabled="@(State.IsCSharpExportRunning || _selectedNames.Count == 0)">匯出成C#</button>
        <button @onclick="DownloadSheet">讀取Sheet資料</button>
        <details class="ps-chapter-filter">
            <summary>章節篩選 (@_selectedChapters.Count/@AllChapters.Count)</summary>
            <div class="ps-chapter-filter-menu">
                <label><input type="checkbox" checked="@AllSelected" @onchange="ToggleAll" /> 全選/全不選</label>
                <hr />
                @foreach (var chapter in AllChapters)
                {
                    <label><input type="checkbox" checked="@_selectedChapters.Contains(chapter)"
                                  @onchange="e => ToggleChapter(chapter, e)" /> @chapter</label>
                }
            </div>
        </details>
        <input class="ps-search" placeholder="搜尋劇本名稱..." @bind="_searchText" @bind:event="oninput" />
        <span class="ps-status">@State.StatusMessage</span>
    </div>
    @if (State.IsSheetScriptDownloadRunning)
    {
        <div class="ps-progress-wrap">
            <div class="ps-progress-bar"><div class="ps-progress-fill" style="width:@(SheetScriptProgressPercent)%"></div></div>
            <span class="ps-progress-text">
                下載中 @State.SheetScriptProcessedCount / @State.SheetScriptQueueTotal
                @if (!string.IsNullOrEmpty(State.SheetScriptCurrentName))
                {
                    <text> — @State.SheetScriptCurrentName</text>
                }
            </span>
        </div>
    }
    @if (State.IsUploadRunning)
    {
        <div class="ps-progress-wrap">
            <div class="ps-progress-bar"><div class="ps-progress-fill" style="width:@(UploadProgressPercent)%"></div></div>
            <span class="ps-progress-text">
                上傳中 @State.UploadProcessedCount / @State.UploadQueueTotal
                @if (!string.IsNullOrEmpty(State.UploadCurrentName))
                {
                    <text> — @State.UploadCurrentName</text>
                }
            </span>
        </div>
    }
    @if (State.IsCSharpExportRunning)
    {
        <div class="ps-progress-wrap">
            <div class="ps-progress-bar"><div class="ps-progress-fill" style="width:@(CSharpExportProgressPercent)%"></div></div>
            <span class="ps-progress-text">
                匯出C#中 @State.CSharpExportProcessedCount / @State.CSharpExportQueueTotal
                @if (!string.IsNullOrEmpty(State.CSharpExportCurrentName))
                {
                    <text> — @State.CSharpExportCurrentName</text>
                }
            </span>
        </div>
    }
    <div class="ps-grid-wrap">
        <table class="ps-grid">
            <thead>
                <tr id="ps-header-row">
                    <th class="ps-select-col">
                        <input type="checkbox" title="全選/全不選（僅目前篩選後可見的列）"
                               checked="@AllVisibleRowsSelected" @onchange="ToggleAllVisibleRows" />
                    </th>
                    @foreach (var col in _columns)
                    {
                        <th @key="col.Key" class="@GetCellClass(col.Key)" title="點擊可排序，拖曳可調整欄位順序"
                            @onclick="() => OnColumnHeaderClicked(col.Key)">
                            @col.Label
                            @if (_sortColumn == col.Key)
                            {
                                <span class="ps-sort-indicator">@(_sortDescending ? "▼" : "▲")</span>
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in FilteredRows)
                {
                    <tr @oncontextmenu="e => OnRowContextMenu(e, row)" @oncontextmenu:preventDefault="true">
                        <td class="ps-select-col">
                            <input type="checkbox" checked="@_selectedNames.Contains(row.PlayscriptName)"
                                   @onclick="e => OnRowCheckboxClicked(row, e)" @onclick:preventDefault="true" />
                        </td>
                        @foreach (var col in _columns)
                        {
                            <td @key="col.Key" class="@GetCellClass(col.Key)" title="@GetCellTitle(col.Key)">@GetCellText(row, col.Key)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        @if (State.Rows.Count == 0)
        {
            <div class="ps-empty">流程圖裡還沒有任何有劇本名稱的節點</div>
        }
    </div>
</div>

@if (_contextMenuRow is { } contextMenuRow)
{
    <div class="ps-context-menu-backdrop" @onclick="CloseContextMenu"
         @oncontextmenu="CloseContextMenu" @oncontextmenu:preventDefault="true"></div>
    <div class="ps-context-menu" style="left:@(_contextMenuX)px; top:@(_contextMenuY)px">
        <button disabled="@(!contextMenuRow.HasLocalScriptFile)" @onclick="OpenLocalScriptFileFromMenu">開啟本地劇本檔</button>
        <button disabled="@(!contextMenuRow.IsOnGraph)" @onclick="JumpToGraphNodeFromMenu">跳到劇情節點</button>
        <button disabled="@(!contextMenuRow.IsOnCSharp)" @onclick="OpenCSharpFileFromMenu">開啟C#檔</button>
        <button disabled="@(!contextMenuRow.IsOnLdtk)" @onclick="LocateInLdtkFromMenu">定位到LDtk</button>
    </div>
}

@if (State.PendingConflict is { } conflict)
{
    <div class="ps-modal-backdrop">
        <div class="ps-modal">
            <h3>劇本檔已存在</h3>
            <p>劇本「@conflict.PlayscriptName」本機已經有 .md 劇本檔，要用剛下載的內容覆蓋它嗎？</p>
            <div class="ps-modal-actions">
                <button @onclick='() => ResolveConflict(SheetScriptConflictChoice.OverwriteOne)'>覆蓋這個</button>
                <button @onclick='() => ResolveConflict(SheetScriptConflictChoice.SkipOne)'>略過這個</button>
                @if (conflict.RemainingConflictCount > 0)
                {
                    <button @onclick='() => ResolveConflict(SheetScriptConflictChoice.OverwriteRemaining)'>覆蓋接下來的 @conflict.RemainingConflictCount 個檔案</button>
                    <button @onclick='() => ResolveConflict(SheetScriptConflictChoice.SkipRemaining)'>略過接下來的 @conflict.RemainingConflictCount 個檔案</button>
                }
            </div>
        </div>
    </div>
}

@if (State.PendingScriptFileConflict is { } scriptConflict)
{
    <div class="ps-modal-backdrop">
        <div class="ps-modal">
            <h3>劇本檔名稱衝突</h3>
            <p>劇本「@scriptConflict.PlayscriptName」的檔名已經被另一個（流程圖上已不存在的）節點佔用，要讓這個節點接管、覆蓋掉舊檔案嗎？</p>
            <div class="ps-modal-actions">
                <button @onclick='() => ResolveScriptFileConflict(SheetScriptConflictChoice.OverwriteOne)'>覆蓋這個</button>
                <button @onclick='() => ResolveScriptFileConflict(SheetScriptConflictChoice.SkipOne)'>略過這個</button>
                @if (scriptConflict.RemainingConflictCount > 0)
                {
                    <button @onclick='() => ResolveScriptFileConflict(SheetScriptConflictChoice.OverwriteRemaining)'>覆蓋接下來的 @scriptConflict.RemainingConflictCount 個</button>
                    <button @onclick='() => ResolveScriptFileConflict(SheetScriptConflictChoice.SkipRemaining)'>略過接下來的 @scriptConflict.RemainingConflictCount 個</button>
                }
            </div>
        </div>
    </div>
}

@if (State.PendingCSharpExportConflict is { } cSharpConflict)
{
    <div class="ps-modal-backdrop">
        <div class="ps-modal">
            <h3>C#檔案已存在</h3>
            <p>劇本「@cSharpConflict.PlayscriptName」本機已經有產生過的 .cs 檔案，要用這次的內容覆蓋它嗎？</p>
            <p class="ps-conflict-warning">如果這個C#檔案裡有劇本表無法表達、額外手動加上去的程式碼（例如走位、鏡頭等），覆蓋後會永久遺失。</p>
            <div class="ps-modal-actions">
                <button @onclick="OpenPendingCSharpExportFile" style="margin-right:auto">開啟C#檔案</button>
                <button @onclick='() => ResolveCSharpExportConflict(SheetScriptConflictChoice.OverwriteOne)'>覆蓋這個</button>
                <button @onclick='() => ResolveCSharpExportConflict(SheetScriptConflictChoice.SkipOne)'>略過這個</button>
                @if (cSharpConflict.RemainingConflictCount > 0)
                {
                    <button @onclick='() => ResolveCSharpExportConflict(SheetScriptConflictChoice.OverwriteRemaining)'>覆蓋接下來的 @cSharpConflict.RemainingConflictCount 個檔案</button>
                    <button @onclick='() => ResolveCSharpExportConflict(SheetScriptConflictChoice.SkipRemaining)'>略過接下來的 @cSharpConflict.RemainingConflictCount 個檔案</button>
                }
            </div>
        </div>
    </div>
}

@if (State.SheetScriptResults is { } results)
{
    <div class="ps-modal-backdrop">
        <div class="ps-modal">
            <h3>下載結果</h3>
            @if (results.Count == 0)
            {
                <p>全部劇本都已成功下載並寫入劇本檔。</p>
            }
            else
            {
                <p>以下 @results.Count 個劇本無法下載：</p>
                <div class="ps-result-list">
                    @foreach (var failure in results)
                    {
                        <div class="ps-result-row"><b>@failure.PlayscriptName</b> — @failure.Reason</div>
                    }
                </div>
            }
            <div class="ps-modal-actions">
                @if (!string.IsNullOrEmpty(_copyFeedback))
                {
                    <span class="ps-copy-feedback">@_copyFeedback</span>
                }
                @if (results.Count > 0)
                {
                    <button @onclick="CopyResultsToClipboard">複製結果</button>
                }
                <button @onclick="CloseResults">關閉</button>
            </div>
        </div>
    </div>
}

@if (_pendingUploadNames is { } pendingUpload)
{
    <div class="ps-modal-backdrop">
        <div class="ps-modal">
            <h3>上傳補完到Sheet</h3>
            <p>即將處理以下 @pendingUpload.Count 個劇本（視情況補索引列、建立專屬Sheet、覆蓋上傳本機劇本檔內容）：</p>
            <div class="ps-result-list">
                @foreach (var name in pendingUpload)
                {
                    <div class="ps-result-row">@name</div>
                }
            </div>
            <div class="ps-modal-actions">
                <button @onclick="CancelUpload">取消</button>
                <button @onclick="ConfirmUpload">確定上傳</button>
            </div>
        </div>
    </div>
}

@if (State.UploadResults is { } uploadResults)
{
    <div class="ps-modal-backdrop">
        <div class="ps-modal">
            <h3>上傳結果</h3>
            @if (uploadResults.Count == 0)
            {
                <p>全部劇本都已成功上傳。</p>
            }
            else
            {
                <p>以下 @uploadResults.Count 個劇本上傳失敗：</p>
                <div class="ps-result-list">
                    @foreach (var failure in uploadResults)
                    {
                        <div class="ps-result-row"><b>@failure.PlayscriptName</b> — @failure.Reason</div>
                    }
                </div>
            }
            <div class="ps-modal-actions">
                @if (!string.IsNullOrEmpty(_uploadCopyFeedback))
                {
                    <span class="ps-copy-feedback">@_uploadCopyFeedback</span>
                }
                @if (uploadResults.Count > 0)
                {
                    <button @onclick="CopyUploadResultsToClipboard">複製結果</button>
                }
                <button @onclick="CloseUploadResults">關閉</button>
            </div>
        </div>
    </div>
}

@if (State.CSharpExportResults is { } cSharpResults)
{
    <div class="ps-modal-backdrop">
        <div class="ps-modal">
            <h3>匯出成C#結果</h3>
            @if (cSharpResults.Count == 0)
            {
                <p>全部劇本都已成功匯出成C#。</p>
            }
            else
            {
                <p>以下 @cSharpResults.Count 個劇本無法匯出：</p>
                <div class="ps-result-list">
                    @foreach (var failure in cSharpResults)
                    {
                        <div class="ps-result-row"><b>@failure.PlayscriptName</b> — @failure.Reason</div>
                    }
                </div>
            }
            <div class="ps-modal-actions">
                @if (!string.IsNullOrEmpty(_cSharpExportCopyFeedback))
                {
                    <span class="ps-copy-feedback">@_cSharpExportCopyFeedback</span>
                }
                @if (cSharpResults.Count > 0)
                {
                    <button @onclick="CopyCSharpExportResultsToClipboard">複製結果</button>
                }
                <button @onclick="CloseCSharpExportResults">關閉</button>
            </div>
        </div>
    </div>
}

