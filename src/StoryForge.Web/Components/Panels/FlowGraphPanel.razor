@using StoryForge.Core.Graph
@using StoryForge.Web.GraphEditor
@implements IDisposable
@inject GraphEditorState State
@inject ReloadCoordinator ReloadCoordinator
@inject StoryForge.Web.FlowGraphFocusCoordinator FlowGraphFocusCoordinator
@inject IJSRuntime JS

<div class="graph-page">
    <div class="graph-toolbar">
        <button @onclick="FitView">縮放至全部</button>
        <button @onclick="RequestImportFromUnity" title="用 Unity 的流程圖覆蓋藍圖（藍圖會先備份）">從Unity匯入</button>
        <button @onclick="RequestExportToUnity" title="存檔後和 Unity 的流程圖合併，寫入 Unity 專案">匯出至Unity</button>
        <input class="graph-search-box" placeholder="搜尋劇本名稱..."
               value="@_searchQuery" @oninput="e => _searchQuery = e.Value?.ToString() ?? string.Empty"
               @onkeydown="OnSearchKeyDown" />
        <button @onclick="RunSearch">搜尋</button>
        <span class="graph-search-status">@_searchStatus</span>
        <span class="graph-status">@State.StatusMessage</span>
    </div>
    <div class="graph-body">
        <canvas id="story-forge-canvas" class="graph-canvas" tabindex="0"></canvas>
        @if (_isLoading)
        {
            <div class="graph-loading-shield" aria-hidden="true"></div>
        }
        @if (_selectedNodeGuid != null)
        {
            <div class="graph-inspector-resize-handle" id="graph-inspector-resize-handle"></div>
            <div class="graph-inspector" id="graph-inspector-panel">
                <div class="graph-inspector-title">@_selectedNodeTitle</div>
                <div class="graph-inspector-guid">@_selectedNodeGuid</div>
                @{
                    var identityFields = _selectedNodeIdentityFields;
                }
                @if (identityFields.Count == 0 && _nodeContent == null)
                {
                    <div class="graph-inspector-empty">這個節點類型沒有可編輯欄位</div>
                }
                else
                {
                    @foreach (var fieldName in identityFields)
                    {
                        <label class="graph-inspector-field">
                            <span>@fieldName</span>
                            <input value="@GetFieldValue(fieldName)"
                                   @onchange="e => OnFieldChanged(fieldName, e)" />
                        </label>
                    }

                    @if (_nodeContent != null)
                    {
                        <label class="graph-inspector-field">
                            <span>memo（存在 Nodes\ 底下的獨立檔案，不是流程圖存檔的一部分）</span>
                            <textarea value="@_nodeContent.Memo" @onchange="OnMemoChanged"></textarea>
                        </label>
                        <label class="graph-inspector-field">
                            <span>衝突</span>
                            <textarea value="@_nodeContent.Conflict" @onchange="OnConflictChanged"></textarea>
                        </label>
                        <label class="graph-inspector-field">
                            <span>變化</span>
                            <textarea value="@_nodeContent.Change" @onchange="OnChangeChanged"></textarea>
                        </label>
                    }
                }
            </div>
        }
        else if (_selectedGroup != null)
        {
            <div class="graph-inspector-resize-handle" id="graph-inspector-resize-handle"></div>
            <div class="graph-inspector" id="graph-inspector-panel">
                <div class="graph-inspector-title">群組</div>
                <div class="graph-inspector-guid">@_selectedGroup.ClientId</div>
                <label class="graph-inspector-field">
                    <span>標題</span>
                    <input value="@_selectedGroup.Title" @onchange="OnGroupTitleChanged" />
                </label>
                <div class="graph-inspector-field">
                    <span>顏色</span>
                    <div class="graph-group-swatches">
                        @foreach (var (name, hex) in GroupColorPresets)
                        {
                            <button class="graph-group-swatch @(IsCurrentGroupColor(hex) ? "selected" : "")"
                                    title="@name" style="background:@hex" @onclick="() => SetGroupColor(hex)"></button>
                        }
                        <label class="graph-group-custom-color" title="自訂顏色">
                            <input type="color" value="@ToColorInputValue(_selectedGroup.Color)"
                                   @onchange="OnGroupCustomColorChanged" />
                            自訂
                        </label>
                    </div>
                </div>
                <div class="graph-inspector-hint">在群組上按右鍵可以刪除群組（群組裡的節點會保留）。</div>
            </div>
        }
    </div>
    <div class="graph-bottom-status @(_loadFailed ? "failed" : _isLoading ? "loading" : "ready")"
         role="status" aria-live="polite">
        <span class="graph-status-dot"></span>
        <span>@_loadStatus</span>
    </div>
</div>

@if (_importPreview != null)
{
    <div class="graph-modal-backdrop">
        <div class="graph-modal">
            <h3>從Unity匯入</h3>
            @if (_importPreview.Error != null)
            {
                <p>無法讀取 Unity 的流程圖：@_importPreview.Error</p>
                <div class="graph-modal-actions">
                    <button @onclick="CancelImportFromUnity">確定</button>
                </div>
            }
            else
            {
                <p>會用 Unity 的流程圖覆蓋藍圖。</p>
                @if (_importPreview.LostChanges.Count > 0 || _importCanvasUnsaved)
                {
                    <p class="graph-modal-warning">以下還沒匯出的修改會消失（藍圖會先備份到「AI劇本\備份」）：</p>
                    <ul class="graph-modal-list">
                        @foreach (var line in _importPreview.LostChanges)
                        {
                            <li>@line</li>
                        }
                        @if (_importCanvasUnsaved)
                        {
                            <li>畫布上還沒存檔的修改</li>
                        }
                    </ul>
                }
                else if (_importPreview.AlreadyUpToDate)
                {
                    <p>藍圖已經和 Unity 相同。</p>
                }
                <div class="graph-modal-actions">
                    <button @onclick="CancelImportFromUnity">取消</button>
                    <button @onclick="ConfirmImportFromUnity">確定匯入</button>
                </div>
            }
        </div>
    </div>
}

@if (_exportPlan != null)
{
    <div class="graph-modal-backdrop">
        <div class="graph-modal graph-modal-wide">
            <h3>匯出至Unity@(_exportPlan.Conflicts.Count > 0 ? $"：有 {_exportPlan.Conflicts.Count} 個衝突" : "")</h3>
            @if (_exportPlan.Error != null)
            {
                <p>匯出前的存檔或讀取失敗：@_exportPlan.Error</p>
                <div class="graph-modal-actions">
                    <button @onclick="CancelExportToUnity">確定</button>
                </div>
            }
            else
            {
                <p>已先存檔。@(_exportPlan.RemoteChanges.Count > 0 ? "Unity 在上次同步後也有修改，會自動合併：" : "")</p>
                @if (_exportPlan.RemoteChanges.Count > 0)
                {
                    <div class="graph-modal-section">Unity 的修改（會保留）</div>
                    <ul class="graph-modal-list">
                        @foreach (var line in _exportPlan.RemoteChanges)
                        {
                            <li>@line</li>
                        }
                    </ul>
                }
                <div class="graph-modal-section">你的修改（會寫入）</div>
                <ul class="graph-modal-list">
                    @if (_exportPlan.LocalChanges.Count == 0)
                    {
                        <li>（沒有）</li>
                    }
                    @foreach (var line in _exportPlan.LocalChanges)
                    {
                        <li>@line</li>
                    }
                </ul>
                @if (_exportPlan.AutoResolvedCount > 0)
                {
                    <p class="graph-modal-note">@_exportPlan.AutoResolvedCount 個項目雙方都移動了位置，採用 StoryForge 的位置。</p>
                }
                @if (_exportPlan.Conflicts.Count > 0)
                {
                    <table class="graph-conflict-table">
                        <thead>
                            <tr><th>項目</th><th>欄位</th><th>Unity</th><th>StoryForge</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var conflict in _exportPlan.Conflicts)
                            {
                                var key = conflict.EntityKey;
                                @for (var i = 0; i < conflict.Fields.Count; i++)
                                {
                                    var field = conflict.Fields[i];
                                    <tr>
                                        @if (i == 0)
                                        {
                                            <td rowspan="@conflict.Fields.Count">@conflict.Label</td>
                                        }
                                        <td>@field.Field</td>
                                        <td>@field.Unity</td>
                                        <td>@field.StoryForge</td>
                                    </tr>
                                }
                                <tr class="graph-conflict-choice">
                                    <td colspan="2"></td>
                                    <td>
                                        <label><input type="radio" name="@key" checked="@(GetSide(key) == GraphMergeSide.Remote)"
                                                      @onchange="() => SetSide(key, GraphMergeSide.Remote)" /> 用 Unity</label>
                                    </td>
                                    <td>
                                        <label><input type="radio" name="@key" checked="@(GetSide(key) == GraphMergeSide.Local)"
                                                      @onchange="() => SetSide(key, GraphMergeSide.Local)" /> 用 StoryForge</label>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="graph-modal-note">
                        <button @onclick="() => SetAllSides(GraphMergeSide.Remote)">全部用 Unity</button>
                        <button @onclick="() => SetAllSides(GraphMergeSide.Local)">全部用 StoryForge</button>
                    </div>
                }
                @if (_exportPlan.ValidationErrors.Count > 0)
                {
                    <p class="graph-modal-warning">合併結果無法通過檢查，不能匯出：</p>
                    <ul class="graph-modal-list">
                        @foreach (var line in _exportPlan.ValidationErrors.Take(20))
                        {
                            <li>@line</li>
                        }
                    </ul>
                }
                else if (_exportPlan.NothingToExport)
                {
                    <p>Unity 的檔案已經是這個版本，不需要寫入。</p>
                }
                <p class="graph-modal-note">寫入前會把 Unity 原檔備份到「AI劇本\備份」。</p>
                <div class="graph-modal-actions">
                    <button @onclick="CancelExportToUnity">取消</button>
                    <button @onclick="ConfirmExportToUnity" disabled="@(_exportPlan.ValidationErrors.Count > 0)">
                        @(_exportPlan.Conflicts.Count > 0 || _exportPlan.RemoteChanges.Count > 0 ? "合併並匯出" : "匯出")
                    </button>
                </div>
            }
        </div>
    </div>
}

@if (_syncResult != null)
{
    <div class="graph-modal-backdrop">
        <div class="graph-modal">
            <h3>@_syncResult.Title</h3>
            <ul class="graph-modal-list">
                @foreach (var line in _syncResult.Details)
                {
                    <li>@line</li>
                }
            </ul>
            <div class="graph-modal-actions">
                <button @onclick="() => _syncResult = null">確定</button>
            </div>
        </div>
    </div>
}

<style>
    /* Fills the tab-body's .tab-pane wrapper (position:absolute; inset:0, sized by Home.razor's flex
       layout below the menubar + tab strip) rather than the viewport directly — this component is now
       always mounted (kept alive so its LiteGraph canvas state survives switching tabs), with the .tab-pane
       wrapper's own display:none/block toggling visibility instead of this component being torn down. */
    .graph-page { height: 100%; width: 100%; display: flex; flex-direction: column; }
    .graph-toolbar { flex: 0 0 auto; display: flex; align-items: center; gap: 8px; padding: 6px 10px; background: #1e1e1e; color: #ddd; }
    .graph-search-box { background: #2a2a2a; color: #eee; border: 1px solid #444; padding: 3px 6px; border-radius: 3px; width: 160px; }
    .graph-search-status { opacity: 0.8; font-size: 12px; }
    .graph-status { margin-left: 8px; opacity: 0.8; }
    .graph-modal-backdrop {
        position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 1000;
        display: flex; align-items: center; justify-content: center;
    }
    .graph-modal {
        background: #262626; color: #ddd; border: 1px solid #444; border-radius: 6px;
        padding: 18px 20px; max-width: 480px; width: 90%;
        display: flex; flex-direction: column; gap: 10px; box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    }
    .graph-modal h3 { margin: 0; }
    .graph-modal p { margin: 0; }
    .graph-modal-wide { max-width: 860px; max-height: 85vh; overflow: auto; }
    .graph-modal-section { font-weight: bold; font-size: 13px; }
    .graph-modal-list { margin: 0; padding-left: 20px; font-size: 13px; line-height: 1.6; word-break: break-all; }
    .graph-modal-warning { color: #e8b86a; }
    .graph-modal-note { font-size: 12px; opacity: 0.8; display: flex; gap: 8px; align-items: center; }
    .graph-conflict-table { border-collapse: collapse; font-size: 13px; width: 100%; }
    .graph-conflict-table th, .graph-conflict-table td { border: 1px solid #3a3a3a; padding: 4px 8px; text-align: left; vertical-align: top; word-break: break-all; }
    .graph-conflict-table th { background: #2e2e2e; }
    .graph-conflict-choice td { border-top: none; background: #222; }
    .graph-conflict-choice label { cursor: pointer; white-space: nowrap; }
    .graph-modal-actions { display: flex; gap: 8px; justify-content: flex-end; }
    .graph-body { position: relative; flex: 1 1 auto; display: flex; min-height: 0; }
    .graph-loading-shield { position: absolute; inset: 0; z-index: 20; cursor: wait; background: rgba(0,0,0,0.04); }
    .graph-bottom-status {
        flex: 0 0 24px; display: flex; align-items: center; gap: 7px; padding: 0 10px;
        box-sizing: border-box; background: #171717; color: #aaa; border-top: 1px solid #333;
        font-family: sans-serif; font-size: 12px;
    }
    .graph-status-dot { width: 7px; height: 7px; border-radius: 50%; background: #5f9f62; }
    .graph-bottom-status.loading .graph-status-dot { background: #d2a43c; animation: graph-status-pulse 1s ease-in-out infinite; }
    .graph-bottom-status.failed { color: #e49a9a; }
    .graph-bottom-status.failed .graph-status-dot { background: #d75a5a; }
    @@keyframes graph-status-pulse { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }
    /* No width/height:100% here — against a sibling (.graph-inspector) that itself has a fixed width, an
       explicit 100% here ignores that sibling entirely and both end up wider than .graph-body, pushing the
       inspector off past the viewport edge (invisible, but present in the DOM). flex:1 1 auto with
       min-width:0 lets it correctly claim only whatever's left after the fixed-width sidebar. */
    /* tabindex="0" on the canvas element (see markup) is required for LiteGraph's own keyboard handling
       (Delete/Backspace to remove selected nodes) to work at all — a plain canvas is never in the
       browser's focus chain, so LiteGraph's canvas.focus() call on mousedown was previously a no-op and
       its keydown listener (bound to the canvas element itself, not document) never fired. outline:none
       here just hides the resulting focus ring, which looks out of place against the graph background. */
    .graph-canvas { flex: 1 1 auto; min-width: 0; display: block; background: #333; outline: none; }
    /* flex:0 0 auto plus an explicit width (not a flex-basis) instead: the resize handle below writes
       directly to this element's width style, and against a flex-basis that write would just get
       overridden back to 280px on the next layout pass. An explicit width free of any flex sizing keeps
       whatever the user drags it to. min/max-width stay in CSS rather than duplicated in JS — the browser
       clamps any style.width write against them on every layout pass regardless of what the drag handler
       computes. */
    .graph-inspector { flex: 0 0 auto; width: 280px; min-width: 160px; max-width: 70vw; overflow: auto; background: #1e1e1e; color: #ddd; padding: 12px; border-left: 1px solid #333; }
    /* A dedicated drag strip on the sidebar's left edge, in place of CSS's native `resize` handle — that
       handle only ever renders as a tiny triangle in the bottom-right corner, which for this sidebar sits
       exactly at the bottom-right corner of the whole page (the sidebar spans full height), making it
       nearly impossible to grab. This strip runs the full height of the sidebar instead. */
    .graph-inspector-resize-handle { flex: 0 0 6px; cursor: col-resize; background: #333; }
    .graph-inspector-resize-handle:hover, .graph-inspector-resize-handle:active { background: #555; }
    .graph-inspector-title { font-weight: bold; margin-bottom: 4px; word-break: break-all; }
    .graph-inspector-guid { font-size: 11px; opacity: 0.5; font-family: monospace; margin-bottom: 12px; word-break: break-all; }
    .graph-inspector-empty { opacity: 0.6; font-size: 13px; }
    .graph-inspector-hint { opacity: 0.5; font-size: 12px; margin-top: 8px; line-height: 1.5; }
    .graph-group-swatches { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    .graph-group-swatch { width: 24px; height: 24px; padding: 0; border: 2px solid #4a4a4a; border-radius: 4px; cursor: pointer; }
    .graph-group-swatch:hover { border-color: #888; }
    .graph-group-swatch.selected { border-color: #fff; }
    .graph-group-custom-color { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; opacity: 0.85; cursor: pointer; }
    .graph-group-custom-color input[type=color] { width: 28px; height: 24px; padding: 0; border: 1px solid #444; background: none; cursor: pointer; }
    .graph-inspector-field { display: block; margin-bottom: 10px; font-size: 13px; }
    .graph-inspector-field span { display: block; margin-bottom: 4px; opacity: 0.8; }
    .graph-inspector-field input { width: 100%; box-sizing: border-box; background: #2a2a2a; color: #eee; border: 1px solid #444; padding: 4px 6px; border-radius: 3px; }
    /* Multi-line, and its own native drag-to-resize handle (bottom-right corner) — same free browser
       behavior as the sidebar's own resize above, just vertical-only here since width already follows the
       sidebar's width. min-height keeps it from being dragged down to a sliver. */
    .graph-inspector-field textarea { width: 100%; min-height: 80px; box-sizing: border-box; background: #2a2a2a; color: #eee; border: 1px solid #444; padding: 4px 6px; border-radius: 3px; font: inherit; resize: vertical; }
</style>

@code {
    private GraphEditorPayload? _payload;
    private DotNetObjectReference<FlowGraphPanel>? _selfRef;

    private string? _selectedNodeGuid;
    private string _selectedNodeTitle = string.Empty;
    private List<string> _selectedNodeIdentityFields = new();
    private Dictionary<string, string> _selectedNodeFieldValues = new();
    private NodeContentEntry? _nodeContent;

    private string _searchQuery = string.Empty;
    private string _searchStatus = string.Empty;
    private bool _isLoading = true;
    private bool _loadFailed;
    private string _loadStatus = "正在載入流程圖……";

    protected override void OnInitialized()
    {
        ReloadCoordinator.Subscribe(LoadAndInit);
        FlowGraphFocusCoordinator.SubscribeFocus(FocusOnPlayscript);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LoadAndInit();

        // ui-draggable.js's own _resizeInitialized guard makes this safe to call on every render while the
        // inspector is shown, not just the render that first shows it (editing a field re-renders too).
        if (_selectedNodeGuid != null || _selectedGroup != null)
            await JS.InvokeVoidAsync("storyForgeUi.makeResizable", "graph-inspector-panel", "graph-inspector-resize-handle");
    }

    private async Task LoadAndInit()
    {
        _isLoading = true;
        _loadFailed = false;
        _loadStatus = "正在載入流程圖資料……";
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            DiagnosticsLog.Write("LoadAndInit: start");
            _payload = State.LoadGraph();
            _loadStatus = $"正在建立 {_payload.Nodes.Count} 個節點、{_payload.Edges.Count} 條連線……";
            await InvokeAsync(StateHasChanged);
            await Task.Yield();
            _selfRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("storyForgeGraph.init", "story-forge-canvas", _payload, _selfRef);
            DiagnosticsLog.Write("LoadAndInit: done, status=" + State.StatusMessage);
            _isLoading = false;
            _loadStatus = $"流程圖已就緒：{_payload.Nodes.Count} 節點、{_payload.Edges.Count} 連線";
        }
        catch (Exception e)
        {
            DiagnosticsLog.Write("LoadAndInit: EXCEPTION " + e);
            _isLoading = false;
            _loadFailed = true;
            _loadStatus = $"流程圖載入失敗：{e.Message}";
        }

        await InvokeAsync(StateHasChanged);
    }

    // Called from graph-editor.js the instant it creates a node via the add-node menu (before the node is
    // necessarily selected) — makes the node real in the live model right away rather than waiting for
    // 存檔, so OnNodeSelectionChanged below can find it immediately.
    [JSInvokable]
    public void OnNodeCreated(string guid, string typeName, float x, float y)
    {
        State.CreateNode(guid, typeName, x, y);
    }

    // Called from graph-editor.js's own undo/redo stack when it rolls back past the point a node was
    // created — that creation already reached the live model immediately (OnNodeCreated above), so undoing
    // it client-side alone would leave a server-side orphan (no edges, but still written into session.json
    // on the next unrelated 存檔) unless this mirrors the removal there too.
    [JSInvokable]
    public void OnNodeUndoRemoved(string guid)
    {
        RemoveUnsavedNode(guid);
    }

    // Normal Delete/context-menu removal of a node created since the last successful save. Existing nodes
    // remain in the server model until ApplyAndSave consumes deletedNodeGuids; only unsaved nodes use this
    // immediate path because they cannot appear in a diff against the previous saved baseline.
    [JSInvokable]
    public void OnUnsavedNodeRemoved(string guid)
    {
        RemoveUnsavedNode(guid);
    }

    private void RemoveUnsavedNode(string guid)
    {
        State.RemoveUnsavedNode(guid);
        if (_selectedNodeGuid == guid)
            OnNodeSelectionChanged(null);
    }

    // Called from graph-editor.js's onSelectionChange — guid is null when nothing (or more than one node)
    // is selected, since the sidebar only ever shows a single node's fields at a time.
    [JSInvokable]
    public void OnNodeSelectionChanged(string? guid)
    {
        _selectedNodeGuid = guid;
        if (guid != null)
            _selectedGroup = null;
        if (guid == null)
        {
            _selectedNodeFieldValues = new();
            _selectedNodeIdentityFields = new();
            _selectedNodeTitle = string.Empty;
            _nodeContent = null;
        }
        else
        {
            // TypeName is read from the live model (via State), not the initial-load _payload.Nodes
            // snapshot — a node created this session via the add-node menu is never in that stale
            // snapshot, but OnNodeCreated above already added it to the live model by the time selection
            // can happen, so this always resolves correctly for both existing and brand-new nodes.
            var typeName = State.GetNodeTypeName(guid);
            var typeDto = _payload?.NodeTypes.FirstOrDefault(t => t.TypeName == typeName);
            var nodeDto = _payload?.Nodes.FirstOrDefault(n => n.Guid == guid);
            _selectedNodeTitle = nodeDto?.Title ?? typeDto?.DisplayName ?? guid;
            _selectedNodeIdentityFields = typeDto?.IdentityFields ?? new();
            // Re-read from the live model rather than trusting the payload snapshot, in case this node's
            // fields were already edited earlier in the session.
            _selectedNodeFieldValues = State.GetNodeFields(guid)?.ToDictionary(kv => kv.Key, kv => kv.Value)
                                        ?? new();
            _nodeContent = State.GetNodeContent(guid);
        }

        StateHasChanged();
    }

    // 群組側邊欄 ─────────────────────────────────────────────────────────────

    public sealed class GroupSelectionDto
    {
        public string ClientId { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string Color { get; set; } = string.Empty;
    }

    private static readonly (string Name, string Hex)[] GroupColorPresets =
    {
        ("預設（黑）", "#000000"), ("紅", "#a84a4a"), ("橘", "#b06634"), ("黃", "#b58b2a"), ("綠", "#4a8a4a"), ("青", "#3f8f8f"),
        ("藍", "#3f789e"), ("紫", "#7a4fa1"), ("桃紅", "#a1309b"), ("灰", "#555555"),
    };

    private GroupSelectionDto? _selectedGroup;

    // 點群組標題列時由 graph-editor.js 呼叫；info 為 null 代表取消群組選取
    [JSInvokable]
    public void OnGroupSelectionChanged(GroupSelectionDto? info)
    {
        _selectedGroup = info;
        if (info != null)
        {
            _selectedNodeGuid = null;
            _selectedNodeFieldValues = new();
            _selectedNodeIdentityFields = new();
            _selectedNodeTitle = string.Empty;
            _nodeContent = null;
        }

        StateHasChanged();
    }

    private async Task OnGroupTitleChanged(ChangeEventArgs e)
    {
        if (_selectedGroup == null)
            return;

        var title = e.Value?.ToString()?.Trim() ?? string.Empty;
        if (await JS.InvokeAsync<bool>("storyForgeGraph.setGroupProperties", _selectedGroup.ClientId, title, null))
            _selectedGroup.Title = title;
    }

    private Task OnGroupCustomColorChanged(ChangeEventArgs e) => SetGroupColor(e.Value?.ToString() ?? string.Empty);

    private async Task SetGroupColor(string hex)
    {
        if (_selectedGroup == null || string.IsNullOrEmpty(hex))
            return;

        if (await JS.InvokeAsync<bool>("storyForgeGraph.setGroupProperties", _selectedGroup.ClientId, null, hex))
            _selectedGroup.Color = hex;
    }

    private bool IsCurrentGroupColor(string hex) =>
        _selectedGroup != null && string.Equals(ToColorInputValue(_selectedGroup.Color), hex, StringComparison.OrdinalIgnoreCase);

    // <input type="color"> 只接受 #rrggbb：把 #rgb 簡寫展開，其他格式（例如 rgba(...)）退回預設色
    private static string ToColorInputValue(string? color)
    {
        if (string.IsNullOrEmpty(color) || color[0] != '#')
            return "#335533";
        if (color.Length == 4)
            return $"#{color[1]}{color[1]}{color[2]}{color[2]}{color[3]}{color[3]}".ToLowerInvariant();
        return color.Length >= 7 ? color[..7].ToLowerInvariant() : "#335533";
    }

    private string GetFieldValue(string fieldName) =>
        _selectedNodeFieldValues.TryGetValue(fieldName, out var value) ? value : string.Empty;

    // Called from graph-editor.js's node right-click menu just before it opens, to decide whether
    // 開啟劇本檔/複製劇本名稱 should be enabled — a live disk/model read rather than trusting the initial
    // payload snapshot, which can go stale after a sidebar field edit (see GraphEditorState.UpdateNodeField).
    [JSInvokable]
    public NodeContextMenuInfoDto GetNodeContextMenuInfo(string guid) => State.GetNodeContextMenuInfo(guid);

    // 開啟劇本檔 moved here from its old sidebar button — the right-click menu passes the guid explicitly
    // since it's never tied to whichever node the sidebar currently has selected.
    [JSInvokable]
    public void OpenScriptTableForGuid(string guid)
    {
        State.OpenScriptTable(guid);
        StateHasChanged();
    }

    // The server-side half of the right-click menu's 複製 action — see GraphEditorState.DuplicateNode for
    // what actually gets copied (every field including playscriptId, plus 劇本 content). Edge duplication
    // is entirely graph-editor.js's own responsibility since links never round-trip through this class
    // until 存檔.
    [JSInvokable]
    public NodeDuplicateResultDto? DuplicateNode(string sourceGuid, string newGuid, float x, float y) =>
        State.DuplicateNode(sourceGuid, newGuid, x, y);

    private void OnMemoChanged(ChangeEventArgs e)
    {
        if (_selectedNodeGuid == null || _nodeContent == null)
            return;

        var value = e.Value?.ToString() ?? string.Empty;
        _nodeContent.Memo = value;
        State.SetNodeMemo(_selectedNodeGuid, value);
    }

    private void OnConflictChanged(ChangeEventArgs e)
    {
        if (_selectedNodeGuid == null || _nodeContent == null)
            return;

        var value = e.Value?.ToString() ?? string.Empty;
        _nodeContent.Conflict = value;
        State.SetNodeConflict(_selectedNodeGuid, value);
    }

    private void OnChangeChanged(ChangeEventArgs e)
    {
        if (_selectedNodeGuid == null || _nodeContent == null)
            return;

        var value = e.Value?.ToString() ?? string.Empty;
        _nodeContent.Change = value;
        State.SetNodeChange(_selectedNodeGuid, value);
    }

    // Pushes the node's recomputed title (GetNodeTitleInfo — the same playscriptId/flagId-or-fallback
    // formula the initial payload and 複製 use) to both the canvas and this sidebar's own header the moment
    // an identity field changes, instead of leaving them stale until the next reload — UpdateNodeField
    // itself only touches the server-side model, see its own comment for why.
    private async Task OnFieldChanged(string fieldName, ChangeEventArgs e)
    {
        if (_selectedNodeGuid == null)
            return;

        var value = e.Value?.ToString() ?? string.Empty;
        var finalValue = State.UpdateNodeField(_selectedNodeGuid, fieldName, value) ?? value;
        _selectedNodeFieldValues[fieldName] = finalValue;

        var titleInfo = State.GetNodeTitleInfo(_selectedNodeGuid);
        if (titleInfo != null)
        {
            _selectedNodeTitle = titleInfo.Title;
            await JS.InvokeVoidAsync("storyForgeGraph.updateNodeTitle",
                _selectedNodeGuid, titleInfo.Title, titleInfo.HasIdentityTitle);
        }
    }

    public void Dispose()
    {
        ReloadCoordinator.Unsubscribe(LoadAndInit);
        FlowGraphFocusCoordinator.UnsubscribeFocus(FocusOnPlayscript);
        _selfRef?.Dispose();
    }

    // "跳到劇情節點"'s focus half — see FlowGraphFocusCoordinator for why Home.razor's tab switch always
    // runs before this. Reuses the exact same search box/status field the toolbar's own 搜尋 uses, so a
    // playscript jumped to this way still shows up as "已定位到：X" and repeating the same jump afterwards
    // via either path continues cycling through duplicate-name matches together, not as two separate
    // search histories. Goes through focusOnPlayscriptWhenVisible (not plain searchNode) since the canvas
    // may still be mid-transition from display:none when this runs — see that JS function's own comment.
    private async Task FocusOnPlayscript(string playscriptName)
    {
        _searchQuery = playscriptName;
        var found = await JS.InvokeAsync<bool>("storyForgeGraph.focusOnPlayscriptWhenVisible", playscriptName);
        _searchStatus = found ? $"已定位到：{playscriptName}" : $"找不到符合「{playscriptName}」的節點";
        StateHasChanged();
    }

    // 從Unity匯入 ─────────────────────────────────────────────────────────

    private ImportFromUnityPreview? _importPreview;
    private bool _importCanvasUnsaved;

    private async Task RequestImportFromUnity()
    {
        _importCanvasUnsaved = State.HasUnsavedChanges() ||
                               await JS.InvokeAsync<bool>("storyForgeGraph.hasCanvasChanges");
        _importPreview = State.PrepareImportFromUnity();
    }

    private void CancelImportFromUnity() => _importPreview = null;

    private async Task ConfirmImportFromUnity()
    {
        _importPreview = null;
        State.ImportFromUnity();
        await FinishSyncAsync();
    }

    // 匯出至Unity ─────────────────────────────────────────────────────────

    private ExportToUnityPlan? _exportPlan;
    private readonly Dictionary<string, GraphMergeSide> _exportResolutions = new();

    // 先存檔（取得畫布目前的內容），再準備合併，給使用者確認
    private async Task RequestExportToUnity()
    {
        var export = await JS.InvokeAsync<GraphEditorExport>("storyForgeGraph.exportGraph");
        _exportPlan = State.PrepareExportToUnity(export);
        _exportResolutions.Clear();
        if (_exportPlan.Error == null)
        {
            await JS.InvokeVoidAsync("storyForgeGraph.markSaveSucceeded");
            foreach (var conflict in _exportPlan.Conflicts)
                _exportResolutions[conflict.EntityKey] = GraphMergeSide.Local;
        }
    }

    private GraphMergeSide GetSide(string entityKey) =>
        _exportResolutions.TryGetValue(entityKey, out var side) ? side : GraphMergeSide.Local;

    private void SetSide(string entityKey, GraphMergeSide side) => _exportResolutions[entityKey] = side;

    private void SetAllSides(GraphMergeSide side)
    {
        foreach (var key in _exportResolutions.Keys.ToList())
            _exportResolutions[key] = side;
    }

    private void CancelExportToUnity()
    {
        _exportPlan = null;
        State.CancelExportToUnity();
    }

    private async Task ConfirmExportToUnity()
    {
        _exportPlan = null;
        State.ExportToUnity(new Dictionary<string, GraphMergeSide>(_exportResolutions));
        await FinishSyncAsync();
    }

    // 匯入、匯出成功後藍圖已經換成新版本，重新載入所有分頁（流程圖、劇本管線狀態等）再顯示結果
    private SaveReport? _syncResult;

    private async Task FinishSyncAsync()
    {
        var report = State.LastSaveReport;
        if (report?.SaveSucceeded == true)
            await ReloadCoordinator.RequestReloadAsync();

        _syncResult = report;
        StateHasChanged();
        if (report != null)
            await JS.InvokeVoidAsync("storyForgeUi.playSaveFeedback", report.Outcome.ToString());
    }

    private async Task FitView()
    {
        await JS.InvokeVoidAsync("storyForgeGraph.fitView");
    }

    // Mirrors the WinForms ProcessGraphPanel toolbar's own search box+button+Enter-key wiring — same
    // "找不到/已定位到" status wording, and repeating the identical query cycles through matches instead of
    // re-jumping to the first one (see graph-editor.js's searchNode).
    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await RunSearch();
    }

    private async Task RunSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
            return;

        var found = await JS.InvokeAsync<bool>("storyForgeGraph.searchNode", _searchQuery);
        _searchStatus = found ? $"已定位到：{_searchQuery}" : $"找不到符合「{_searchQuery}」的節點";
    }
}
