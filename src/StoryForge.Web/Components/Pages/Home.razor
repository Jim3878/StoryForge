@page "/"
@using StoryForge.Web.Components.Panels
@implements IDisposable
@inject FlowGraphFocusCoordinator FlowGraphFocusCoordinator
@inject StoryForge.Core.Graph.AppSettings AppSettings
@inject IJSRuntime JS

@* The "分頁" layer between MainLayout's global 工具列 and each panel's own 分頁工具列 (流程圖's
   重新載入/存檔/縮放至全部, 角色卡's 新增角色/刪除角色). Both panels are ALWAYS rendered — switching
   tabs only toggles a wrapper div's display:none/block — rather than @if-ing one away, so a panel's own
   state (FlowGraphPanel's LiteGraph canvas especially) survives switching tabs and back with no reload. *@
<PageTitle>StoryForge</PageTitle>

<div class="tab-shell">
    @* Only the strip's button order is user-reorderable (drag, remembered in AppSettings.TabOrder) — the
       .tab-pane divs below stay in their fixed DOM order regardless, which matters for the
       FlowGraphPanel-before-PipelineStatusPanel ordering explained further down. *@
    <div class="tab-strip" id="tab-strip">
        @foreach (var tab in _tabs)
        {
            <button @key="tab.Key" class="tab-strip-item @(_activeTab == tab.Key ? "active" : "")"
                    @onclick="() => SetTab(tab.Key)">@tab.Label</button>
        }
    </div>
    <div class="tab-body">
        <div class="tab-pane" style="display:@(_activeTab == "outline" ? "block" : "none")">
            <StoryOutlinePanel />
        </div>
        @* FlowGraphPanel is mounted before PipelineStatusPanel deliberately — this DOM order has no visual
           effect (each .tab-pane is absolutely positioned and shown/hidden via display), but it does drive
           Blazor's OnAfterRenderAsync ordering: PipelineStatusPanel's own firstRender reads
           GraphEditorState's model (via PipelineStatusState.Refresh), which is only populated once
           FlowGraphPanel.LoadAndInit's synchronous LoadGraph() call has run. Reordering these two divs back
           would silently reintroduce that race. *@
        <div class="tab-pane" style="display:@(_activeTab == "graph" ? "block" : "none")">
            <FlowGraphPanel />
        </div>
        <div class="tab-pane" style="display:@(_activeTab == "pipeline" ? "block" : "none")">
            <PipelineStatusPanel />
        </div>
        <div class="tab-pane" style="display:@(_activeTab == "card" ? "block" : "none")">
            <CharacterCardPanel />
        </div>
        <div class="tab-pane" style="display:@(_activeTab == "bgm" ? "block" : "none")">
            <AudioBrowserPanel Category="StoryForge.Core.Audio.AudioCategory.Bgm" />
        </div>
        <div class="tab-pane" style="display:@(_activeTab == "sfx" ? "block" : "none")">
            <AudioBrowserPanel Category="StoryForge.Core.Audio.AudioCategory.Sfx" />
        </div>
    </div>
</div>

<style>
    /* Fills MainLayout's .app-content box (fixed, top:32px, below the global menubar). */
    .tab-shell { position: absolute; inset: 0; display: flex; flex-direction: column; }
    .tab-strip { flex: 0 0 auto; display: flex; gap: 4px; padding: 4px 8px 0; background: #1a1a1a; border-bottom: 1px solid #333; font-family: sans-serif; }
    .tab-strip-item { background: #242424; color: #aaa; border: 1px solid #3a3a3a; border-bottom: none; padding: 6px 18px; border-radius: 4px 4px 0 0; cursor: pointer; font-size: 13px; }
    .tab-strip-item:hover { background: #2c2c2c; }
    .tab-strip-item.active { background: #333; color: #fff; }
    /* position:relative establishes the containing block .tab-pane's position:absolute measures against —
       without it, each pane would size itself against the viewport instead of this flex-allotted box. */
    .tab-body { flex: 1 1 auto; position: relative; min-height: 0; }
    .tab-pane { position: absolute; inset: 0; }
</style>

@code {
    private sealed record TabDef(string Key, string Label);

    private static readonly IReadOnlyList<TabDef> DefaultTabs = new List<TabDef>
    {
        new("outline", "世界書"),
        new("pipeline", "劇本管線狀態"),
        new("graph", "流程圖"),
        new("card", "角色卡"),
        new("bgm", "BGM"),
        new("sfx", "音效"),
    };

    private string _activeTab = "graph";
    private List<TabDef> _tabs = new();
    private DotNetObjectReference<Home>? _selfRef;

    private async Task SetTab(string tab)
    {
        if (_activeTab == tab)
            return;
        _activeTab = tab;
        // Nothing should keep playing from a tab that's no longer visible.
        await JS.InvokeVoidAsync("storyForgeAudio.stopAll");
    }

    protected override void OnInitialized()
    {
        FlowGraphFocusCoordinator.SubscribeTabActivation(ActivateGraphTab);

        // Saved order first (skipping keys no longer known), then any tab the saved order doesn't mention
        // yet — e.g. one added in a later build — at the end in its default position.
        var byKey = DefaultTabs.ToDictionary(t => t.Key);
        _tabs = AppSettings.TabOrder.Where(byKey.ContainsKey).Distinct().Select(k => byKey[k]).ToList();
        _tabs.AddRange(DefaultTabs.Where(t => !_tabs.Contains(t)));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _selfRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("storyForgeColumnSort.initReverting", "tab-strip", _selfRef, nameof(OnTabReordered), null);
    }

    [JSInvokable]
    public void OnTabReordered(int oldIndex, int newIndex)
    {
        if (oldIndex < 0 || oldIndex >= _tabs.Count || newIndex < 0 || newIndex >= _tabs.Count)
            return;

        var tab = _tabs[oldIndex];
        _tabs.RemoveAt(oldIndex);
        _tabs.Insert(newIndex, tab);

        // Read-modify-write through a fresh load rather than saving the circuit's own AppSettings copy
        // wholesale — this circuit's copy may predate edits another tab made in the 設定 dialog.
        var fresh = StoryForge.Core.Graph.AppSettings.LoadOrDefault();
        fresh.TabOrder = _tabs.Select(t => t.Key).ToList();
        fresh.Save();
        AppSettings.TabOrder = fresh.TabOrder;
        StateHasChanged();
    }

    // "跳到劇情節點"'s tab-switch half — see FlowGraphFocusCoordinator for why this and FlowGraphPanel's own
    // focus handler are two separate steps run in a fixed order rather than one. InvokeAsync(StateHasChanged)
    // (not a bare StateHasChanged()) since this runs from an event raised by PipelineStatusPanel's own
    // click-handler Task, same reasoning as every other cross-panel callback in this app.
    private Task ActivateGraphTab()
    {
        _activeTab = "graph";
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        FlowGraphFocusCoordinator.UnsubscribeTabActivation(ActivateGraphTab);
        _selfRef?.Dispose();
    }
}
