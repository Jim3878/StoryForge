{
  "name": "@nineday/storyforge-cloud",
  "version": "1.1.0",
  "description": "StoryForge's cloud data layout (docs inside an AFFiNE workspace) and the StoryForge extension for the nineday affine-mcp fork: sf_* tools and the sf CLI.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jim3878/StoryForge.git",
    "directory": "cloud"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "default": "./dist/layout.js"
    },
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "generate": "node scripts/gen-version.mjs && node scripts/copy-assets.mjs",
    "build": "npm run generate && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/schema.test.mjs",
    "prepublishOnly": "npm test",
    "install-into-mcp": "npm run build && node scripts/install-into-mcp.mjs"
  },
  "peerDependencies": {
    "yjs": "^13.6.0"
  },
  "peerDependenciesMeta": {
    "yjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "^5.9.3",
    "yjs": "^13.6.27",
    "zod": "^3.25.76"
  }
}
